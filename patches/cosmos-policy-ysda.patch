+def _sanitize_filename_part(value: Any, max_len: int = 80) -> str:
+    text = str(value).lower().replace("\n", " ").strip()
+    result = []
+    for char in text:
+        if char.isalnum():
+            result.append(char)
+        elif char in {" ", "-", "_", ".", "="}:
+            result.append("_")
+    sanitized = "".join(result).strip("_")
+    while "__" in sanitized:
+        sanitized = sanitized.replace("__", "_")
+    return sanitized[:max_len] or "unknown"
