+def load_trace_file(path: Path) -> pd.DataFrame:
+    if path.suffix == ".parquet":
+        return pd.read_parquet(path)
+    return pd.read_csv(path)
+
+
+def _episode_group_columns(df: pd.DataFrame) -> List[str]:
+    candidates = [
+        "suite",
+        "task_id",
+        "episode_id",
+        "pair_id",
+        "rollout_id",
+        "init_state_id",
+        "base_seed",
+        "rollout_seed",
+    ]
+    return [col for col in candidates if col in df.columns]
+
+
+def _tail_fraction(values: pd.Series, fraction: float) -> float:
+    clean = values.dropna()
+    if len(clean) == 0:
+        return float("nan")
+    n = max(1, int(math.ceil(len(clean) * fraction)))
+    return float(clean.tail(n).mean())
+
+
+def _slope(values: pd.Series, x: pd.Series) -> float:
+    mask = values.notna() & x.notna()
+    if mask.sum() < 2:
+        return float("nan")
+    coeff = np.polyfit(x[mask].to_numpy(dtype=float), values[mask].to_numpy(dtype=float), deg=1)
+    return float(coeff[0])
+
+
+def make_episode_features(trace_df: pd.DataFrame) -> pd.DataFrame:
+    """Create episode-level features from query-level traces."""
+    group_cols = _episode_group_columns(trace_df)
+    metric_cols = _numeric_metric_columns(trace_df)
+    rows: List[Dict[str, Any]] = []
+    for keys, group in trace_df.groupby(group_cols, dropna=False):
+        if not isinstance(keys, tuple):
+            keys = (keys,)
+        row = dict(zip(group_cols, keys))
+        row["success"] = bool(group["success"].iloc[-1])
+        row["failed"] = int(not row["success"])
+        row["final_t"] = int(group["final_t"].iloc[-1]) if "final_t" in group else int(group["t"].max())
+        row["num_queries"] = int(len(group))
+        row["task_description"] = group["task_description"].iloc[-1] if "task_description" in group else ""
+        for col in metric_cols:
+            values = group[col]
+            row[f"{col}__mean"] = float(values.mean())
+            row[f"{col}__std"] = float(values.std(ddof=0))
+            row[f"{col}__max"] = float(values.max())
+            row[f"{col}__min"] = float(values.min())
+            row[f"{col}__last"] = float(values.iloc[-1])
+            row[f"{col}__last3_mean"] = float(values.tail(3).mean())
+            row[f"{col}__last25_mean"] = _tail_fraction(values, 0.25)
+            row[f"{col}__first3_mean"] = float(values.head(3).mean())
+            row[f"{col}__late_minus_early"] = row[f"{col}__last3_mean"] - row[f"{col}__first3_mean"]
+            row[f"{col}__slope"] = _slope(values, group["t"])
+        rows.append(row)
+    return pd.DataFrame(rows)
+
+
+def roc_auc_for_failure(labels_failed: np.ndarray, scores: np.ndarray) -> float:
+    """AUC where positive label means failed episode."""
+    mask = ~np.isnan(scores)
+    labels = labels_failed[mask].astype(int)
+    scores = scores[mask].astype(float)
+    n_pos = int(labels.sum())
+    n_neg = int(len(labels) - n_pos)
+    if n_pos == 0 or n_neg == 0:
+        return float("nan")
+    ranks = stats.rankdata(scores)
+    sum_pos = ranks[labels == 1].sum()
+    return float((sum_pos - n_pos * (n_pos + 1) / 2) / (n_pos * n_neg))
+
+
+def best_threshold_balanced_accuracy(
+    labels_failed: np.ndarray, scores: np.ndarray, high_means_failed: bool
+) -> Tuple[float, float]:
+    mask = ~np.isnan(scores)
+    labels = labels_failed[mask].astype(bool)
+    scores = scores[mask].astype(float)
+    if labels.sum() == 0 or (~labels).sum() == 0:
+        return float("nan"), float("nan")
+    thresholds = np.unique(scores)
+    best_thr = float(thresholds[0])
+    best_bal_acc = -1.0
+    for thr in thresholds:
+        pred_failed = scores >= thr if high_means_failed else scores <= thr
+        tpr = (pred_failed & labels).sum() / labels.sum()
+        tnr = ((~pred_failed) & (~labels)).sum() / (~labels).sum()
+        bal_acc = 0.5 * (tpr + tnr)
+        if bal_acc > best_bal_acc:
+            best_bal_acc = float(bal_acc)
+            best_thr = float(thr)
+    return best_thr, best_bal_acc
+
+
+def rank_episode_features(episode_df: pd.DataFrame) -> pd.DataFrame:
+    """Rank episode-level features by success/failure separation."""
+    labels = episode_df["failed"].to_numpy(dtype=int)
+    rows: List[Dict[str, Any]] = []
+    skip = set(METADATA_COLUMNS) | {"failed"}
+    for col in episode_df.columns:
+        if col in skip or not pd.api.types.is_numeric_dtype(episode_df[col]):
+            continue
+        scores = episode_df[col].to_numpy(dtype=float)
+        if np.isnan(scores).all() or np.nanstd(scores) == 0:
+            continue
+        auc_high = roc_auc_for_failure(labels, scores)
+        if np.isnan(auc_high):
+            continue
+        high_means_failed = auc_high >= 0.5
+        oriented_auc = auc_high if high_means_failed else 1.0 - auc_high
+        failed_scores = scores[labels == 1]
+        success_scores = scores[labels == 0]
+        failed_scores = failed_scores[~np.isnan(failed_scores)]
+        success_scores = success_scores[~np.isnan(success_scores)]
+        p_value = float("nan")
+        if len(failed_scores) > 0 and len(success_scores) > 0:
+            try:
+                p_value = float(stats.mannwhitneyu(failed_scores, success_scores, alternative="two-sided").pvalue)
+            except ValueError:
+                p_value = float("nan")
+        threshold, bal_acc = best_threshold_balanced_accuracy(labels, scores, high_means_failed)
+        pooled_std = float(np.nanstd(scores))
+        effect = (
+            float((np.nanmean(failed_scores) - np.nanmean(success_scores)) / pooled_std)
+            if pooled_std > 0
+            else float("nan")
+        )
+        rows.append(
+            {
+                "feature": col,
+                "oriented_auc": float(oriented_auc),
+                "auc_high_means_failed": float(auc_high),
+                "direction": "high=failure" if high_means_failed else "low=failure",
+                "best_threshold": threshold,
+                "best_balanced_accuracy": bal_acc,
+                "failed_mean": float(np.nanmean(failed_scores)) if len(failed_scores) else float("nan"),
+                "success_mean": float(np.nanmean(success_scores)) if len(success_scores) else float("nan"),
+                "effect_failed_minus_success": effect,
+                "mannwhitney_p": p_value,
+                "n_failed": int(labels.sum()),
+                "n_success": int((1 - labels).sum()),
+            }
+        )
+    return pd.DataFrame(rows).sort_values(["oriented_auc", "best_balanced_accuracy"], ascending=False)
+
+
+def split_episode_feature_name(feature: str) -> Tuple[str, str]:
+    """Split ``metric__aggregation`` names used by episode features."""
+    if "__" not in feature:
+        return feature, "raw"
+    metric, aggregation = feature.rsplit("__", 1)
+    return metric, aggregation
+
+
+def summarize_ranked_feature_groups(ranked_df: pd.DataFrame, group_col: str) -> pd.DataFrame:
+    """Summarize ranked features by metric family or aggregation."""
+    if len(ranked_df) == 0:
+        return pd.DataFrame()
+
+    rows: List[Dict[str, Any]] = []
+    for group_value, group in ranked_df.groupby(group_col, dropna=False):
+        ordered = group.sort_values(["oriented_auc", "best_balanced_accuracy"], ascending=False)
+        top = ordered.iloc[0]
+        rows.append(
+            {
+                group_col: group_value,
+                "best_feature": top["feature"],
+                "best_oriented_auc": float(top["oriented_auc"]),
+                "best_balanced_accuracy": float(top["best_balanced_accuracy"]),
+                "best_direction": top["direction"],
+                "best_failed_mean": float(top["failed_mean"]),
+                "best_success_mean": float(top["success_mean"]),
+                "mean_oriented_auc": float(group["oriented_auc"].mean()),
+                "median_oriented_auc": float(group["oriented_auc"].median()),
+                "num_features": int(len(group)),
+            }
+        )
+    return pd.DataFrame(rows).sort_values(["best_oriented_auc", "mean_oriented_auc"], ascending=False)
+
+
+def summarize_ranked_features(ranked_df: pd.DataFrame) -> Tuple[pd.DataFrame, pd.DataFrame]:
+    """Return metric-family and aggregation summaries for ranked episode features."""
+    if len(ranked_df) == 0:
+        return pd.DataFrame(), pd.DataFrame()
+    enriched = ranked_df.copy()
+    split_names = enriched["feature"].map(split_episode_feature_name)
+    enriched["metric_family"] = [metric for metric, _ in split_names]
+    enriched["aggregation"] = [aggregation for _, aggregation in split_names]
+    return (
+        summarize_ranked_feature_groups(enriched, "metric_family"),
+        summarize_ranked_feature_groups(enriched, "aggregation"),
+    )
+
+
+def rank_episode_features_within_groups(episode_df: pd.DataFrame, group_cols: Sequence[str]) -> pd.DataFrame:
+    """Rank features after requiring success/failure variation within groups."""
+    columns = [
+        "feature",
+        "group_cols",
+        "num_valid_groups",
+        "num_valid_episodes",
+        "mean_oriented_auc",
+        "weighted_mean_oriented_auc",
+        "min_oriented_auc",
+        "max_oriented_auc",
+    ]
+    skip = set(METADATA_COLUMNS) | {"failed"}
+    rows: List[Dict[str, Any]] = []
+    valid_groups = [
+        group
+        for _, group in episode_df.groupby(list(group_cols), dropna=False)
+        if group["failed"].nunique(dropna=True) == 2
+    ]
+    if not valid_groups:
+        return pd.DataFrame(columns=columns)
+
+    for col in episode_df.columns:
+        if col in skip or not pd.api.types.is_numeric_dtype(episode_df[col]):
+            continue
+        aucs = []
+        weights = []
+        for group in valid_groups:
+            scores = group[col].to_numpy(dtype=float)
+            if np.isnan(scores).all() or np.nanstd(scores) == 0:
+                continue
+            labels = group["failed"].to_numpy(dtype=int)
+            auc_high = roc_auc_for_failure(labels, scores)
+            if np.isnan(auc_high):
+                continue
+            aucs.append(max(auc_high, 1.0 - auc_high))
+            weights.append(len(group))
+        if not aucs:
+            continue
+        auc_array = np.array(aucs, dtype=float)
+        weight_array = np.array(weights, dtype=float)
+        rows.append(
+            {
+                "feature": col,
+                "group_cols": ",".join(group_cols),
+                "num_valid_groups": int(len(auc_array)),
+                "num_valid_episodes": int(weight_array.sum()),
+                "mean_oriented_auc": float(auc_array.mean()),
+                "weighted_mean_oriented_auc": float(np.average(auc_array, weights=weight_array)),
+                "min_oriented_auc": float(auc_array.min()),
+                "max_oriented_auc": float(auc_array.max()),
+            }
+        )
+    if not rows:
+        return pd.DataFrame(columns=columns)
+    return pd.DataFrame(rows).sort_values(["weighted_mean_oriented_auc", "mean_oriented_auc"], ascending=False)
+
+
+def _zscore_series(series: pd.Series) -> pd.Series:
+    std = series.std(ddof=0)
+    if std == 0 or np.isnan(std):
+        return pd.Series(np.zeros(len(series)), index=series.index)
+    return (series - series.mean()) / std
+
+
+def add_composite_scores(
+    episode_df: pd.DataFrame, ranked_df: Optional[pd.DataFrame] = None, top_k: int = 5
+) -> pd.DataFrame:
+    """Add predefined and top-k oriented composite risk scores."""
+    result = episode_df.copy()
+    predefined = [
+        ("action_std_mean__last3_mean", 1.0),
+        ("action_first_step_l2_std__last3_mean", 1.0),
+        ("value_std__last3_mean", 1.0),
+        ("future_image_pixel_std_mean__last3_mean", 1.0),
+        ("latent_action_copy_std_mean_mean_over_samples__last3_mean", 1.0),
+        ("value_mean__last3_mean", -1.0),
+    ]
+    parts = []
+    used = []
+    for col, sign in predefined:
+        if col in result.columns:
+            parts.append(sign * _zscore_series(result[col]))
+            used.append(col)
+    if parts:
+        result["risk_predefined_last3"] = sum(parts) / len(parts)
+        result.attrs["risk_predefined_last3_features"] = used
+
+    if ranked_df is not None and len(ranked_df) > 0:
+        top = ranked_df.head(top_k)
+        parts = []
+        used = []
+        for row in top.itertuples(index=False):
+            sign = 1.0 if row.direction == "high=failure" else -1.0
+            parts.append(sign * _zscore_series(result[row.feature]))
+            used.append(row.feature)
+        if parts:
+            result[f"risk_top{top_k}_oriented"] = sum(parts) / len(parts)
+            result.attrs[f"risk_top{top_k}_oriented_features"] = used
+    return result
+
+
+def make_time_aligned_features(trace_df: pd.DataFrame, grid_size: int = 21) -> pd.DataFrame:
+    """Interpolate each query metric to normalized progress grid per episode."""
+    group_cols = _episode_group_columns(trace_df)
+    metric_cols = _numeric_metric_columns(trace_df)
+    grid = np.linspace(0.0, 1.0, grid_size)
+    rows: List[Dict[str, Any]] = []
+    for keys, group in trace_df.groupby(group_cols, dropna=False):
+        if not isinstance(keys, tuple):
+            keys = (keys,)
+        group = group.sort_values("t")
+        progress = group["query_idx"].to_numpy(dtype=float)
+        if len(progress) == 1 or progress.max() == progress.min():
+            progress = np.zeros_like(progress)
+        else:
+            progress = (progress - progress.min()) / (progress.max() - progress.min())
+        for metric in metric_cols:
+            values = group[metric].to_numpy(dtype=float)
+            if np.isnan(values).all():
+                continue
+            valid = ~np.isnan(values)
+            interp = (
+                np.interp(grid, progress[valid], values[valid])
+                if valid.sum() > 1
+                else np.full_like(grid, values[valid][0])
+            )
+            for p, value in zip(grid, interp):
+                row = dict(zip(group_cols, keys))
+                row.update(
+                    {
+                        "success": bool(group["success"].iloc[-1]),
+                        "failed": int(not bool(group["success"].iloc[-1])),
+                        "metric": metric,
+                        "progress": float(p),
+                        "value": float(value),
+                    }
+                )
+                rows.append(row)
+    return pd.DataFrame(rows)
+
+
+def rank_time_aligned_metrics(aligned_df: pd.DataFrame) -> pd.DataFrame:
+    """Rank base metrics by best separation at any normalized progress point."""
+    rows = []
+    for (metric, progress), group in aligned_df.groupby(["metric", "progress"], dropna=False):
+        labels = group["failed"].to_numpy(dtype=int)
+        values = group["value"].to_numpy(dtype=float)
+        auc_high = roc_auc_for_failure(labels, values)
+        if np.isnan(auc_high):
+            continue
+        oriented_auc = max(auc_high, 1.0 - auc_high)
+        rows.append(
+            {
+                "metric": metric,
+                "progress": float(progress),
+                "oriented_auc": float(oriented_auc),
+                "direction": "high=failure" if auc_high >= 0.5 else "low=failure",
+                "failed_mean": float(np.nanmean(values[labels == 1])),
+                "success_mean": float(np.nanmean(values[labels == 0])),
+            }
+        )
+    ranked = pd.DataFrame(rows)
+    if len(ranked) == 0:
+        return ranked
+    return ranked.sort_values(["oriented_auc"], ascending=False)
+
+
+def rank_uncertainty_error_correlations(trace_df: pd.DataFrame, min_samples: int = 8) -> pd.DataFrame:
+    """Rank query-level correlations between uncertainty signals and prediction errors."""
+    numeric_cols = _numeric_metric_columns(trace_df)
+    error_cols = [
+        col
+        for col in numeric_cols
+        if col.startswith("prediction_error_")
+        and not col.startswith("prediction_error_value_abs_final_success")
+        and not col.startswith("prediction_error_value_abs_chunk_success")
+    ]
+    uncertainty_cols = [
+        col
+        for col in numeric_cols
+        if not col.startswith("prediction_error_")
+        and not col.startswith("prediction_value_")
+        and not col.startswith("actual_object_state_")
+        and col not in {"chunk_success"}
+    ]
+    rows: List[Dict[str, Any]] = []
+    for uncertainty_col in uncertainty_cols:
+        for error_col in error_cols:
+            values = trace_df[[uncertainty_col, error_col]].replace([np.inf, -np.inf], np.nan).dropna()
+            if len(values) < min_samples:
+                continue
+            if values[uncertainty_col].nunique() < 2 or values[error_col].nunique() < 2:
+                continue
+            rho, p_value = stats.spearmanr(values[uncertainty_col], values[error_col])
+            if np.isnan(rho):
+                continue
+            rows.append(
+                {
+                    "uncertainty_metric": uncertainty_col,
+                    "prediction_error_metric": error_col,
+                    "spearman_r": float(rho),
+                    "abs_spearman_r": float(abs(rho)),
+                    "p_value": float(p_value),
+                    "n": int(len(values)),
+                }
+            )
+    if not rows:
+        return pd.DataFrame(
+            columns=["uncertainty_metric", "prediction_error_metric", "spearman_r", "abs_spearman_r", "p_value", "n"]
+        )
+    return pd.DataFrame(rows).sort_values(["abs_spearman_r", "n"], ascending=False)
+
+
+def save_top_feature_plots(episode_df: pd.DataFrame, ranked_df: pd.DataFrame, output_dir: Path, top_n: int = 8) -> None:
+    if len(ranked_df) == 0:
+        return
+    plot_dir = output_dir / "plots"
+    plot_dir.mkdir(parents=True, exist_ok=True)
+    for stale_plot in plot_dir.glob("box__*.png"):
+        stale_plot.unlink()
+    top = ranked_df.head(top_n)
+    for row in top.itertuples(index=False):
+        values_success = episode_df.loc[episode_df["failed"] == 0, row.feature].dropna().to_numpy()
+        values_failed = episode_df.loc[episode_df["failed"] == 1, row.feature].dropna().to_numpy()
+        if len(values_success) == 0 or len(values_failed) == 0:
+            continue
+        plt.figure(figsize=(5, 4))
+        plt.boxplot([values_success, values_failed], tick_labels=["success", "failed"], showmeans=True)
+        plt.title(f"{row.feature}\nAUC={row.oriented_auc:.3f}, {row.direction}")
+        plt.ylabel(row.feature)
+        plt.tight_layout()
+        safe_name = row.feature.replace("/", "_").replace(" ", "_")
+        plt.savefig(plot_dir / f"box__{safe_name}.png", dpi=160)
+        plt.close()
+
+
+def analyze_trace_file(trace_path: Path, output_dir: Path, grid_size: int = 21, top_k: int = 5) -> Dict[str, Path]:
+    output_dir.mkdir(parents=True, exist_ok=True)
+    trace_df = load_trace_file(trace_path)
+    if len(trace_df) == 0:
+        raise ValueError(f"trace file is empty: {trace_path}")
+
+    episode_df = make_episode_features(trace_df)
+    ranked_df = rank_episode_features(episode_df)
+    episode_df = add_composite_scores(episode_df, ranked_df, top_k=top_k)
+    ranked_with_composites = rank_episode_features(episode_df)
+    metric_family_ranked_df, aggregation_ranked_df = summarize_ranked_features(ranked_with_composites)
+    ranked_within_suite_df = rank_episode_features_within_groups(episode_df, ["suite"])
+    ranked_within_suite_task_df = rank_episode_features_within_groups(episode_df, ["suite", "task_id"])
+    ranked_within_pair_df = (
+        rank_episode_features_within_groups(episode_df, ["pair_id"])
+        if "pair_id" in episode_df.columns
+        else pd.DataFrame()
+    )
+    aligned_df = make_time_aligned_features(trace_df, grid_size=grid_size)
+    aligned_ranked_df = rank_time_aligned_metrics(aligned_df)
+    uncertainty_error_corr_df = rank_uncertainty_error_correlations(trace_df)
+
+    episode_path = output_dir / "episode_features.csv"
+    ranked_path = output_dir / "ranked_episode_features.csv"
+    metric_family_path = output_dir / "ranked_metric_families.csv"
+    aggregation_path = output_dir / "ranked_aggregations.csv"
+    ranked_within_suite_path = output_dir / "ranked_within_suite_features.csv"
+    ranked_within_suite_task_path = output_dir / "ranked_within_suite_task_features.csv"
+    ranked_within_pair_path = output_dir / "ranked_within_pair_features.csv"
+    aligned_path = output_dir / "time_aligned_features.csv"
+    aligned_ranked_path = output_dir / "ranked_time_aligned_metrics.csv"
+    uncertainty_error_corr_path = output_dir / "ranked_uncertainty_error_correlations.csv"
+    summary_path = output_dir / "summary.json"
+
+    episode_df.to_csv(episode_path, index=False)
+    ranked_with_composites.to_csv(ranked_path, index=False)
+    metric_family_ranked_df.to_csv(metric_family_path, index=False)
+    aggregation_ranked_df.to_csv(aggregation_path, index=False)
+    ranked_within_suite_df.to_csv(ranked_within_suite_path, index=False)
+    ranked_within_suite_task_df.to_csv(ranked_within_suite_task_path, index=False)
+    ranked_within_pair_df.to_csv(ranked_within_pair_path, index=False)
+    aligned_df.to_csv(aligned_path, index=False)
+    aligned_ranked_df.to_csv(aligned_ranked_path, index=False)
+    uncertainty_error_corr_df.to_csv(uncertainty_error_corr_path, index=False)
+    save_top_feature_plots(episode_df, ranked_with_composites, output_dir)
+
+    summary = {
+        "trace_path": str(trace_path),
+        "num_query_rows": int(len(trace_df)),
+        "num_episodes": int(len(episode_df)),
+        "num_success": int((episode_df["failed"] == 0).sum()),
+        "num_failed": int((episode_df["failed"] == 1).sum()),
+        "top_episode_features": ranked_with_composites.head(15).to_dict(orient="records"),
+        "top_metric_families": metric_family_ranked_df.head(15).to_dict(orient="records")
+        if len(metric_family_ranked_df)
+        else [],
+        "top_aggregations": aggregation_ranked_df.head(15).to_dict(orient="records")
+        if len(aggregation_ranked_df)
+        else [],
+        "top_within_suite_features": ranked_within_suite_df.head(15).to_dict(orient="records")
+        if len(ranked_within_suite_df)
+        else [],
+        "top_within_suite_task_features": ranked_within_suite_task_df.head(15).to_dict(orient="records")
+        if len(ranked_within_suite_task_df)
+        else [],
+        "top_within_pair_features": ranked_within_pair_df.head(15).to_dict(orient="records")
+        if len(ranked_within_pair_df)
+        else [],
+        "top_time_aligned": aligned_ranked_df.head(15).to_dict(orient="records") if len(aligned_ranked_df) else [],
+        "top_uncertainty_error_correlations": uncertainty_error_corr_df.head(15).to_dict(orient="records")
+        if len(uncertainty_error_corr_df)
+        else [],
+        "composite_features": {key: value for key, value in episode_df.attrs.items() if key.startswith("risk_")},
+    }
+    summary_path.write_text(json.dumps(summary, indent=2))
+    return {
+        "episode_features": episode_path,
+        "ranked_episode_features": ranked_path,
+        "ranked_metric_families": metric_family_path,
+        "ranked_aggregations": aggregation_path,
+        "ranked_within_suite_features": ranked_within_suite_path,
+        "ranked_within_suite_task_features": ranked_within_suite_task_path,
+        "ranked_within_pair_features": ranked_within_pair_path,
+        "time_aligned_features": aligned_path,
+        "ranked_time_aligned_metrics": aligned_ranked_path,
+        "ranked_uncertainty_error_correlations": uncertainty_error_corr_path,
+        "summary": summary_path,
+    }
+
