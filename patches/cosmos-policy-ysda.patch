+# SPDX-License-Identifier: Apache-2.0
+"""Denoising-trace utilities for flow-based Cosmos Policy uncertainty.
+
+There are two deliberately separate metrics in this module:
+
+* ``compute_blockwise_vfd`` implements the cross-model Vector Field
+  Disagreement (VFD) estimator.  It requires every ensemble model to be
+  evaluated along every ensemble trajectory.
+* ``summarize_flow_path_dispersion`` compares stochastic trajectories from one
+  model.  It is useful before an epistemic model ensemble is available, but it
+  is not called VFD because the vector fields are evaluated at different
+  points.
+"""
+
+from __future__ import annotations
+
+from collections.abc import Mapping, Sequence
+from typing import Any
+
+import numpy as np
+import torch
+
+TRACE_FORMAT_VERSION = 1
+
+
+def edm_sigma_to_flow_time(sigma: Any) -> Any:
+    """Map Cosmos EDM sigma to normalized flow time ``t = sigma / (1 + sigma)``."""
+    return sigma / (1.0 + sigma)
+
+
+def edm_sigma_to_vfd_weight(sigma: Any) -> Any:
+    """Return the VFD weight in Cosmos coordinates: ``kappa = 1 / sigma``."""
+    return 1.0 / sigma
+
+
+def edm_x0_to_flow_velocity(
+    noisy_state: torch.Tensor,
+    x0_prediction: torch.Tensor,
+    sigma: torch.Tensor | float,
+) -> torch.Tensor:
+    """Recover normalized-flow velocity from an EDM x0 prediction.
+
+    Cosmos uses ``x_sigma = x0 + sigma * epsilon``.  With normalized flow time
+    ``t = sigma / (1 + sigma)``, the corresponding velocity is
+
+    ``v_t = epsilon_hat - x0_hat``,
+    ``epsilon_hat = (x_sigma - x0_hat) / sigma``.
+    """
+    sigma_tensor = torch.as_tensor(sigma, dtype=noisy_state.dtype, device=noisy_state.device)
+    if torch.any(sigma_tensor <= 0):
+        raise ValueError("sigma must be strictly positive when recovering velocity")
+    while sigma_tensor.ndim < noisy_state.ndim:
+        sigma_tensor = sigma_tensor.unsqueeze(-1)
+    epsilon_prediction = (noisy_state - x0_prediction) / sigma_tensor
+    return epsilon_prediction - x0_prediction
+
+
+class DenoisingTraceRecorder:
+    """Record selected latent-frame velocities at every solver denoiser call.
+
+    The recorder is a sampler callback.  It immediately moves only requested
+    latent blocks to CPU float32, keeping GPU memory bounded and avoiding raw
+    image/latent trace persistence.
+    """
+
+    def __init__(self, block_indices: Mapping[str, int], sigma_floor: float = 1e-8):
+        self.block_indices = {
+            str(name): int(index)
+            for name, index in block_indices.items()
+            if index is not None and int(index) >= 0
+        }
+        self.sigma_floor = float(sigma_floor)
+        self._sigmas: list[float] = []
+        self._block_velocities: dict[str, list[np.ndarray]] = {
+            name: [] for name in self.block_indices
+        }
+        self.excluded_terminal_evaluations = 0
+
+    def __call__(
+        self,
+        *,
+        noisy_state_B_StateShape: torch.Tensor,
+        sigma_B: torch.Tensor,
+        x0_pred_B_StateShape: torch.Tensor,
+        **_: Any,
+    ) -> None:
+        sigma_values = sigma_B.detach().to(dtype=torch.float64).cpu().numpy().reshape(-1)
+        if sigma_values.size == 0 or not np.allclose(sigma_values, sigma_values[0]):
+            raise ValueError("DenoisingTraceRecorder expects one shared sigma across the batch")
+        sigma = float(sigma_values[0])
+        if not np.isfinite(sigma) or sigma <= self.sigma_floor:
+            self.excluded_terminal_evaluations += 1
+            return
+
+        velocity = edm_x0_to_flow_velocity(
+            noisy_state_B_StateShape,
+            x0_pred_B_StateShape,
+            sigma_B,
+        )
+        if velocity.ndim != 5:
+            raise ValueError(f"Expected latent shape (B,C,T,H,W), got {tuple(velocity.shape)}")
+
+        block_values: dict[str, np.ndarray] = {}
+        for name, latent_index in self.block_indices.items():
+            if latent_index >= velocity.shape[2]:
+                raise IndexError(
+                    f"Latent index {latent_index} for block {name!r} exceeds T={velocity.shape[2]}"
+                )
+            block_values[name] = (
+                velocity[:, :, latent_index, :, :]
+                .detach()
+                .to(dtype=torch.float32, device="cpu")
+                .numpy()
+                .copy()
+            )
+
+        self._sigmas.append(sigma)
+        for name, value in block_values.items():
+            self._block_velocities[name].append(value)
+
+    def as_dict(self) -> dict[str, Any]:
+        """Return a compact, serializable-in-memory trace dictionary."""
+        sigmas = np.asarray(self._sigmas, dtype=np.float64)
+        block_velocities = {
+            name: np.stack(values, axis=0)
+            for name, values in self._block_velocities.items()
+            if values
+        }
+        return {
+            "format_version": TRACE_FORMAT_VERSION,
+            "sigmas": sigmas,
+            "flow_times": edm_sigma_to_flow_time(sigmas),
+            "vfd_weights": edm_sigma_to_vfd_weight(sigmas) if sigmas.size else sigmas.copy(),
+            "block_velocities": block_velocities,
+            "excluded_terminal_evaluations": int(self.excluded_terminal_evaluations),
+        }
+
+
+def _validate_trace(trace: Mapping[str, Any]) -> tuple[np.ndarray, Mapping[str, Any]]:
+    sigmas = np.asarray(trace.get("sigmas", []), dtype=np.float64)
+    blocks = trace.get("block_velocities", {})
+    if sigmas.ndim != 1:
+        raise ValueError(f"Trace sigmas must have shape (L,), got {sigmas.shape}")
+    if not isinstance(blocks, Mapping):
+        raise TypeError("Trace block_velocities must be a mapping")
+    for name, values in blocks.items():
+        array = np.asarray(values)
+        if array.shape[0] != len(sigmas):
+            raise ValueError(
+                f"Block {name!r} has {array.shape[0]} denoising steps, expected {len(sigmas)}"
+            )
+    return sigmas, blocks
+
+
+def summarize_flow_path_dispersion(
+    traces: Sequence[Mapping[str, Any]],
+    sigma_floor: float = 1e-8,
+) -> dict[str, float]:
+    """Compare same-step velocities from stochastic trajectories of one model.
+
+    Each velocity was evaluated at that sample's own noisy state.  Consequently
+    this measures trajectory dispersion, not epistemic cross-model VFD.
+    Squared differences are averaged over all block elements, so action/value
+    and image blocks are dimension-normalized.
+    """
+    if len(traces) < 2:
+        return {}
+
+    validated = [_validate_trace(trace) for trace in traces]
+    reference_sigmas = validated[0][0]
+    if len(reference_sigmas) == 0:
+        return {}
+    for sigmas, _blocks in validated[1:]:
+        if sigmas.shape != reference_sigmas.shape or not np.allclose(
+            sigmas, reference_sigmas, rtol=1e-6, atol=1e-9
+        ):
+            return {
+                "flow_path_trace_aligned": 0.0,
+                "flow_path_num_members": float(len(traces)),
+            }
+
+    valid_steps = np.isfinite(reference_sigmas) & (reference_sigmas > float(sigma_floor))
+    if not valid_steps.any():
+        return {}
+    weights = edm_sigma_to_vfd_weight(reference_sigmas[valid_steps])
+    common_blocks = set(validated[0][1])
+    for _sigmas, blocks in validated[1:]:
+        common_blocks.intersection_update(blocks)
+
+    metrics: dict[str, float] = {
+        "flow_path_trace_aligned": 1.0,
+        "flow_path_num_members": float(len(traces)),
+        "flow_path_num_steps": float(valid_steps.sum()),
+        "flow_path_sigma_min": float(reference_sigmas[valid_steps].min()),
+        "flow_path_sigma_max": float(reference_sigmas[valid_steps].max()),
+    }
+    for block_name in sorted(common_blocks):
+        member_values = [
+            np.asarray(blocks[block_name], dtype=np.float32)[valid_steps]
+            for _sigmas, blocks in validated
+        ]
+        pairwise_step_mse = []
+        for left in range(len(member_values)):
+            for right in range(left + 1, len(member_values)):
+                difference = member_values[left] - member_values[right]
+                reduce_axes = tuple(range(1, difference.ndim))
+                pairwise_step_mse.append(np.mean(np.square(difference), axis=reduce_axes))
+        mean_step_mse = np.mean(np.stack(pairwise_step_mse, axis=0), axis=0)
+        prefix = f"flow_path_dispersion_{block_name}"
+        metrics[f"{prefix}_mse"] = float(mean_step_mse.mean())
+        metrics[f"{prefix}_vfd_weighted"] = float(np.mean(weights * mean_step_mse))
+        metrics[f"{prefix}_weight_normalized"] = float(
+            np.sum(weights * mean_step_mse) / np.sum(weights)
+        )
+    return metrics
+
+
+def compute_blockwise_vfd(
+    cross_evaluated_velocities: Mapping[str, Any],
+    sigmas: Any,
+    sigma_floor: float = 1e-8,
+) -> dict[str, float]:
+    """Compute exact block-wise VFD from cross-evaluated ensemble velocities.
+
+    For each block, velocities must have shape
+    ``(M_trajectory, M_evaluator, L_step, ...)``.  Element ``[i, j, l]`` is the
+    velocity predicted by model ``j`` at step ``l`` along model ``i``'s
+    trajectory.  The estimator is
+
+    ``mean_{i != j, l} [ (1 / sigma_{i,l}) *
+    mean_elements((v_{i,i,l} - v_{i,j,l})**2) ]``.
+
+    ``sigmas`` may have shape ``(L,)`` or ``(M, L)``.  Steps at or below
+    ``sigma_floor`` are excluded to avoid the singular terminal weight.
+    """
+    sigma_array = np.asarray(sigmas, dtype=np.float64)
+    results: dict[str, float] = {}
+
+    for block_name, raw_velocities in cross_evaluated_velocities.items():
+        velocities = np.asarray(raw_velocities, dtype=np.float32)
+        if velocities.ndim < 4:
+            raise ValueError(
+                f"Block {block_name!r} must have shape (M,M,L,...), got {velocities.shape}"
+            )
+        num_trajectories, num_evaluators, num_steps = velocities.shape[:3]
+        if num_trajectories != num_evaluators:
+            raise ValueError(
+                f"Block {block_name!r} needs a square model grid, got "
+                f"{num_trajectories} trajectories and {num_evaluators} evaluators"
+            )
+        if num_trajectories < 2:
+            raise ValueError("VFD requires at least two ensemble models")
+
+        if sigma_array.ndim == 1:
+            if sigma_array.shape != (num_steps,):
+                raise ValueError(f"Expected sigmas shape ({num_steps},), got {sigma_array.shape}")
+            block_sigmas = np.broadcast_to(sigma_array, (num_trajectories, num_steps))
+        elif sigma_array.ndim == 2:
+            if sigma_array.shape != (num_trajectories, num_steps):
+                raise ValueError(
+                    f"Expected sigmas shape ({num_trajectories},{num_steps}), got {sigma_array.shape}"
+                )
+            block_sigmas = sigma_array
+        else:
+            raise ValueError(f"sigmas must have shape (L,) or (M,L), got {sigma_array.shape}")
+
+        weighted_disagreements = []
+        reduce_axes = tuple(range(1, velocities.ndim - 2))
+        for trajectory_index in range(num_trajectories):
+            valid_steps = (
+                np.isfinite(block_sigmas[trajectory_index])
+                & (block_sigmas[trajectory_index] > float(sigma_floor))
+            )
+            if not valid_steps.any():
+                continue
+            weights = edm_sigma_to_vfd_weight(block_sigmas[trajectory_index, valid_steps])
+            reference = velocities[trajectory_index, trajectory_index, valid_steps]
+            for evaluator_index in range(num_evaluators):
+                if evaluator_index == trajectory_index:
+                    continue
+                difference = reference - velocities[trajectory_index, evaluator_index, valid_steps]
+                step_mse = np.mean(np.square(difference), axis=reduce_axes)
+                weighted_disagreements.extend((weights * step_mse).tolist())
+
+        if not weighted_disagreements:
+            results[str(block_name)] = float("nan")
+        else:
+            results[str(block_name)] = float(np.mean(weighted_disagreements))
+
+    return results
