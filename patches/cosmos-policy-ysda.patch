+def parse_int_list(value: str) -> List[int]:
+    if value.strip().lower() in {"", "all"}:
+        return []
+    result: List[int] = []
+    for part in value.split(","):
+        part = part.strip()
+        if not part:
+            continue
+        if "-" in part:
+            lo, hi = part.split("-", 1)
+            result.extend(range(int(lo), int(hi) + 1))
+        else:
+            result.append(int(part))
+    return result
+
