+    planning_value_margin: float = 0.002,
+    planning_uncertainty_margin: float = 0.0,
+    planning_phase_fraction: float = 0.5,
+    planning_short_open_loop_steps: int = 8,
+    planning_surrogate_error_threshold: float = PROPRIO_ERROR_SURROGATE_V1_DEFAULT_THRESHOLD,
+    record_denoising_trace: bool = False,
+    collect_safety_signals: bool = False,
+    terminate_on_safety_violation: bool = False,
+    num_open_loop_steps: int = 16,
+    num_denoising_steps_action: int = 5,
