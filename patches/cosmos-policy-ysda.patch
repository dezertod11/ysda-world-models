+# SPDX-License-Identifier: Apache-2.0
+"""Time-aligned action-chunk consistency metrics for receding-horizon control."""
+
+from __future__ import annotations
+
+from typing import Dict, Optional
+
+import numpy as np
+
+
+EPS = 1e-8
+CONTINUOUS_ACTION_DIM = 6
+
+
+def _invalid_metrics(executed_steps: int = 0) -> Dict[str, float]:
+    return {
+        "overlap_valid": False,
+        "overlap_length": 0.0,
+        "overlap_previous_executed_steps": float(executed_steps),
+        "overlap_selected_rmse": float("nan"),
+        "overlap_selected_all_rmse": float("nan"),
+        "overlap_first_l2": float("nan"),
+        "overlap_xyz_rmse": float("nan"),
+        "overlap_rot_rmse": float("nan"),
+        "overlap_gripper_mismatch": float("nan"),
+        "overlap_cosine_distance": float("nan"),
+        "overlap_direction_reversal_rate": float("nan"),
+        "overlap_support_min": float("nan"),
+        "overlap_switch_gap": float("nan"),
+        "overlap_set_chamfer": float("nan"),
+        "overlap_energy_distance": float("nan"),
+        "overlap_mmd2_median": float("nan"),
+        "overlap_mmd_gamma": float("nan"),
+        "overlap_shift": float("nan"),
+        "overlap_coupled_mean": float("nan"),
+    }
+
+
+def _validate_actions(name: str, actions: np.ndarray) -> np.ndarray:
+    array = np.asarray(actions, dtype=np.float64)
+    if array.ndim != 3:
+        raise ValueError(f"{name} must have shape [samples, horizon, action_dim], got {array.shape}")
+    if array.shape[0] < 1 or array.shape[1] < 1 or array.shape[2] < 1:
+        raise ValueError(f"{name} has an empty dimension: {array.shape}")
+    if not np.isfinite(array).all():
+        raise ValueError(f"{name} contains non-finite actions")
+    return array
+
+
+def _rmse(left: np.ndarray, right: np.ndarray) -> float:
+    return float(np.sqrt(np.mean(np.square(left - right))))
+
+
+def _pairwise_rmse(left: np.ndarray, right: np.ndarray) -> np.ndarray:
+    differences = left[:, None, ...] - right[None, :, ...]
+    return np.sqrt(np.mean(np.square(differences), axis=tuple(range(2, differences.ndim))))
+
+
+def _pairwise_squared_distance(values: np.ndarray) -> np.ndarray:
+    flat = values.reshape(values.shape[0], -1)
+    differences = flat[:, None, :] - flat[None, :, :]
+    return np.sum(np.square(differences), axis=-1)
+
+
+def _rbf_mmd2(old: np.ndarray, new: np.ndarray) -> tuple[float, float]:
+    combined = np.concatenate([old, new], axis=0)
+    squared = _pairwise_squared_distance(combined)
+    upper = squared[np.triu_indices(len(combined), k=1)]
+    positive = upper[upper > EPS]
+    gamma = float(np.median(positive)) if positive.size else 1.0
+
+    old_squared = _pairwise_squared_distance(old)
+    new_squared = _pairwise_squared_distance(new)
+    old_new = old.reshape(old.shape[0], -1)[:, None, :] - new.reshape(new.shape[0], -1)[None, :, :]
+    cross_squared = np.sum(np.square(old_new), axis=-1)
+    old_kernel = np.exp(-old_squared / max(gamma, EPS))
+    new_kernel = np.exp(-new_squared / max(gamma, EPS))
+    cross_kernel = np.exp(-cross_squared / max(gamma, EPS))
+
+    def off_diagonal_mean(kernel: np.ndarray) -> float:
+        count = kernel.shape[0]
+        if count < 2:
+            return 0.0
+        return float((kernel.sum() - np.trace(kernel)) / (count * (count - 1)))
+
+    mmd2 = off_diagonal_mean(old_kernel) + off_diagonal_mean(new_kernel) - 2.0 * float(cross_kernel.mean())
+    return float(mmd2), gamma
+
+
+def _cosine_metrics(old: np.ndarray, new: np.ndarray) -> tuple[float, float]:
+    old_norm = np.linalg.norm(old, axis=-1)
+    new_norm = np.linalg.norm(new, axis=-1)
+    denominator = old_norm * new_norm
+    both_zero = (old_norm <= EPS) & (new_norm <= EPS)
+    valid = denominator > EPS
+    cosine = np.zeros_like(denominator)
+    cosine[both_zero] = 1.0
+    cosine[valid] = np.sum(old[valid] * new[valid], axis=-1) / denominator[valid]
+    cosine = np.clip(cosine, -1.0, 1.0)
+    return float(np.mean(1.0 - cosine)), float(np.mean(cosine < 0.0))
+
+
+def temporal_overlap_metrics(
+    previous_actions: Optional[np.ndarray],
+    current_actions: np.ndarray,
+    *,
+    previous_selected_idx: int = 0,
+    current_selected_idx: int = 0,
+    previous_executed_steps: int = 0,
+    max_window: Optional[int] = 8,
+) -> Dict[str, float]:
+    """Compare an old unexecuted tail with the new time-aligned prefix.
+
+    Actions have shape ``[B, H, D]``. If the previous query executed ``K``
+    actions, ``previous[:, K:K+L]`` is aligned with ``current[:, :L]``.
+    Metrics are intentionally unscaled; robust action-dimension scales and
+    frozen RBF bandwidths are fitted later on calibration episodes.
+    """
+    current = _validate_actions("current_actions", current_actions)
+    if previous_actions is None:
+        return _invalid_metrics(previous_executed_steps)
+    previous = _validate_actions("previous_actions", previous_actions)
+    if previous.shape[2] != current.shape[2]:
+        raise ValueError(f"action dimensions differ: previous={previous.shape[2]} current={current.shape[2]}")
+    if not 0 <= previous_selected_idx < previous.shape[0]:
+        raise IndexError("previous_selected_idx is outside the previous candidate set")
+    if not 0 <= current_selected_idx < current.shape[0]:
+        raise IndexError("current_selected_idx is outside the current candidate set")
+
+    available = min(previous.shape[1] - int(previous_executed_steps), current.shape[1])
+    if max_window is not None:
+        available = min(available, int(max_window))
+    if previous_executed_steps <= 0 or available <= 0:
+        return _invalid_metrics(previous_executed_steps)
+
+    old = previous[:, previous_executed_steps : previous_executed_steps + available]
+    new = current[:, :available]
+    continuous_dim = min(CONTINUOUS_ACTION_DIM, old.shape[2])
+    old_continuous = old[:, :, :continuous_dim]
+    new_continuous = new[:, :, :continuous_dim]
+    selected_old = old_continuous[previous_selected_idx]
+    selected_new = new_continuous[current_selected_idx]
+
+    pairwise = _pairwise_rmse(old_continuous, new_continuous)
+    selected_rmse = float(pairwise[previous_selected_idx, current_selected_idx])
+    support = float(pairwise[previous_selected_idx].min())
+    within_old = _pairwise_rmse(old_continuous, old_continuous)
+    within_new = _pairwise_rmse(new_continuous, new_continuous)
+    energy = 2.0 * float(pairwise.mean()) - float(within_old.mean()) - float(within_new.mean())
+    mmd2, gamma = _rbf_mmd2(old_continuous, new_continuous)
+    old_flat = old_continuous.reshape(old_continuous.shape[0], -1)
+    new_flat = new_continuous.reshape(new_continuous.shape[0], -1)
+    spread = float(np.var(old_flat, axis=0).sum() + np.var(new_flat, axis=0).sum())
+    shift = float(np.linalg.norm(old_flat.mean(axis=0) - new_flat.mean(axis=0)) / np.sqrt(spread + EPS))
+    cosine_distance, reversal_rate = _cosine_metrics(selected_old, selected_new)
+
+    coupled = float("nan")
+    if old.shape[0] == new.shape[0]:
+        coupled = float(np.mean(np.diag(pairwise)))
+
+    result = _invalid_metrics(previous_executed_steps)
+    result.update(
+        {
+            "overlap_valid": True,
+            "overlap_length": float(available),
+            "overlap_selected_rmse": selected_rmse,
+            "overlap_selected_all_rmse": _rmse(old[previous_selected_idx], new[current_selected_idx]),
+            "overlap_first_l2": float(np.linalg.norm(selected_old[0] - selected_new[0])),
+            "overlap_xyz_rmse": _rmse(
+                old[previous_selected_idx, :, : min(3, old.shape[2])],
+                new[current_selected_idx, :, : min(3, new.shape[2])],
+            ),
+            "overlap_rot_rmse": (
+                _rmse(
+                    old[previous_selected_idx, :, 3:continuous_dim],
+                    new[current_selected_idx, :, 3:continuous_dim],
+                )
+                if continuous_dim > 3
+                else float("nan")
+            ),
+            "overlap_gripper_mismatch": (
+                float(np.mean(np.sign(old[previous_selected_idx, :, -1]) != np.sign(new[current_selected_idx, :, -1])))
+                if old.shape[2] > CONTINUOUS_ACTION_DIM
+                else float("nan")
+            ),
+            "overlap_cosine_distance": cosine_distance,
+            "overlap_direction_reversal_rate": reversal_rate,
+            "overlap_support_min": support,
+            "overlap_switch_gap": selected_rmse - support,
+            "overlap_set_chamfer": float(0.5 * (pairwise.min(axis=1).mean() + pairwise.min(axis=0).mean())),
+            "overlap_energy_distance": float(energy),
+            "overlap_mmd2_median": mmd2,
+            "overlap_mmd_gamma": gamma,
+            "overlap_shift": shift,
+            "overlap_coupled_mean": coupled,
+        }
+    )
+    return result
