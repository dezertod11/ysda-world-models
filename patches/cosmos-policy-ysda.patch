+@dataclass(frozen=True)
+class ActionIntervention:
+    """Deterministic action edit used to create controlled failure rollouts."""
+
+    mode: str = "none"
+    start_t: int = 0
+    end_t: Optional[int] = None
+    start_query: Optional[int] = None
+    end_query: Optional[int] = None
+    gripper: float = 1.0
+    scale: float = 0.0
+    bias: Tuple[float, ...] = ()
+
+    @property
+    def enabled(self) -> bool:
+        return self.mode != "none"
+
+    def applies(self, t: int, query_idx: int) -> bool:
+        if not self.enabled:
+            return False
+        if t < self.start_t:
+            return False
+        if self.end_t is not None and t >= self.end_t:
+            return False
+        if self.start_query is not None and query_idx < self.start_query:
+            return False
+        if self.end_query is not None and query_idx > self.end_query:
+            return False
+        return True
+
+    def apply(self, action: Any) -> np.ndarray:
+        edited = np.asarray(action, dtype=np.float32).copy()
+        if self.mode == "zero_all":
+            edited[:] = 0.0
+        elif self.mode == "zero_motion":
+            edited[:-1] = 0.0
+        elif self.mode == "gripper":
+            edited[-1] = float(self.gripper)
+        elif self.mode == "scale":
+            edited *= float(self.scale)
+        elif self.mode == "bias":
+            if not self.bias:
+                raise ValueError("bias intervention requires a non-empty bias vector")
+            bias = np.asarray(self.bias, dtype=np.float32)
+            if bias.shape != edited.shape:
+                raise ValueError(f"bias shape {bias.shape} does not match action shape {edited.shape}")
+            edited += bias
+        else:
+            raise ValueError(f"Unknown action intervention mode: {self.mode}")
+        return edited
+
