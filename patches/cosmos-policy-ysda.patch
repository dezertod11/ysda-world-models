diff --git a/tests/test_planning_selection.py b/tests/test_planning_selection.py
new file mode 100644
index 0000000..381bd86
--- /dev/null
+++ b/tests/test_planning_selection.py
@@ -0,0 +1,399 @@
+from __future__ import annotations
+
+import numpy as np
+
+from cosmos_policy.experiments.robot.libero.uncertainty_comparison import (
+    PROPRIO_ERROR_SURROGATE_V1_INTERCEPT,
+    PROPRIO_ERROR_SURROGATE_V1_LOG_MEANS,
+    predict_future_proprio_error,
+    select_planning_sample,
+)
+
+
+def sample(value: float) -> dict[str, object]:
+    return {
+        "actions": np.zeros((16, 7), dtype=np.float32),
+        "value_prediction": value,
+    }
+
+
+def sample_with_action(value: float, action: float) -> dict[str, object]:
+    actions = np.full((16, 7), action, dtype=np.float32)
+    return {
+        "actions": actions,
+        "value_prediction": value,
+    }
+
+
+def sample_with_action_copies(value: float, first_std: float, later_std: float) -> dict[str, object]:
+    copy_a = np.zeros((16, 7), dtype=np.float32)
+    copy_b = np.full((16, 7), 2 * later_std, dtype=np.float32)
+    copy_b[0] = 2 * first_std
+    flat = np.concatenate([copy_a.reshape(-1), copy_b.reshape(-1)])
+    latent = flat.reshape(1, 1, 1, 1, -1)
+    return {
+        "actions": copy_a,
+        "value_prediction": value,
+        "generated_latent": latent,
+        "latent_indices": {
+            "action_latent_idx": 0,
+            "future_proprio_latent_idx": -1,
+            "value_latent_idx": -1,
+        },
+    }
+
+
+def test_single_candidate_selection_is_well_defined() -> None:
+    selected, diagnostics = select_planning_sample(
+        [sample(0.25)],
+        strategy="uncertainty_penalty_combined",
+    )
+
+    assert selected == 0
+    assert diagnostics["selected_value"] == 0.25
+    assert diagnostics["selected_value_z"] == 0.0
+    assert diagnostics["selected_risk"] == 0.0
+
+
+def test_multiple_candidate_selection_uses_array_zscore() -> None:
+    selected, diagnostics = select_planning_sample(
+        [sample(0.1), sample(0.8), sample(0.4)],
+        strategy="max_value",
+    )
+
+    assert selected == 1
+    assert diagnostics["max_value_sample_idx"] == 1.0
+    assert np.isclose(diagnostics["candidate_value_range"], 0.7)
+
+
+def test_replay_aliases_repeat_the_reference_selection_rules() -> None:
+    candidates = [
+        sample_with_action_copies(0.8, first_std=1.0, later_std=1.0),
+        sample_with_action_copies(0.7, first_std=0.0, later_std=0.0),
+    ]
+    baseline, _ = select_planning_sample(candidates, strategy="max_value")
+    baseline_replay, _ = select_planning_sample(candidates, strategy="max_value_replay")
+    risk, _ = select_planning_sample(
+        candidates, strategy="uncertainty_penalty_action", risk_lambda=2.0
+    )
+    risk_replay, _ = select_planning_sample(
+        candidates, strategy="uncertainty_penalty_action_replay", risk_lambda=2.0
+    )
+
+    assert baseline_replay == baseline
+    assert risk_replay == risk
+
+
+def test_action_uncertainty_penalty_can_override_max_value() -> None:
+    selected, diagnostics = select_planning_sample(
+        [
+            sample_with_action_copies(0.8, first_std=1.0, later_std=1.0),
+            sample_with_action_copies(0.7, first_std=0.0, later_std=0.0),
+        ],
+        strategy="uncertainty_penalty_action",
+        risk_lambda=2.0,
+    )
+
+    assert selected == 1
+    assert diagnostics["max_value_sample_idx"] == 0.0
+
+
+def test_first_step_and_chunk_aggregation_are_distinct() -> None:
+    candidates = [
+        sample_with_action_copies(0.8, first_std=0.0, later_std=1.0),
+        sample_with_action_copies(0.7, first_std=0.5, later_std=0.5),
+    ]
+
+    first_selected, _ = select_planning_sample(
+        candidates,
+        strategy="uncertainty_penalty_action",
+        risk_lambda=2.0,
+    )
+    chunk_selected, _ = select_planning_sample(
+        candidates,
+        strategy="uncertainty_penalty_action_chunk",
+        risk_lambda=2.0,
+    )
+
+    assert first_selected == 0
+    assert chunk_selected == 1
+
+
+def test_difficulty_gate_is_decided_at_first_query_and_can_be_reused() -> None:
+    candidates = [
+        sample_with_action_copies(0.8, first_std=1.0, later_std=1.0),
+        sample_with_action_copies(0.7, first_std=0.0, later_std=0.0),
+    ]
+
+    selected, diagnostics = select_planning_sample(
+        candidates,
+        strategy="difficulty_gated_action",
+        difficulty_threshold=0.5,
+        risk_lambda=2.0,
+    )
+    assert selected == 1
+    assert diagnostics["planning_episode_risk_enabled"] is True
+
+    selected, diagnostics = select_planning_sample(
+        candidates,
+        strategy="difficulty_gated_action",
+        episode_risk_enabled=False,
+        difficulty_threshold=0.5,
+    )
+    assert selected == 0
+    assert diagnostics["planning_effective_strategy"] == "max_value"
+
+
+def test_margin_gate_blocks_large_value_sacrifice() -> None:
+    candidates = [
+        sample_with_action_copies(0.8, first_std=1.0, later_std=1.0),
+        sample_with_action_copies(0.7, first_std=0.0, later_std=0.0),
+    ]
+
+    selected, diagnostics = select_planning_sample(
+        candidates,
+        strategy="margin_gated_action",
+        risk_lambda=2.0,
+        value_margin=0.01,
+    )
+    assert selected == 0
+    assert diagnostics["planning_query_risk_enabled"] is False
+
+
+def test_consensus_strategy_rejects_action_outlier() -> None:
+    candidates = [
+        sample_with_action(0.8, 10.0),
+        sample_with_action(0.7, 0.0),
+        sample_with_action(0.69, 0.1),
+    ]
+
+    selected, diagnostics = select_planning_sample(
+        candidates,
+        strategy="consensus_action",
+        risk_lambda=2.0,
+    )
+    assert selected != 0
+    assert diagnostics["candidate_action_consensus_first_mean"] > 0.0
+
+
+def test_phase_gate_uses_uncertainty_only_in_configured_phase() -> None:
+    candidates = [
+        sample_with_action_copies(0.8, first_std=1.0, later_std=1.0),
+        sample_with_action_copies(0.7, first_std=0.0, later_std=0.0),
+    ]
+
+    early, _ = select_planning_sample(
+        candidates,
+        strategy="phase_gated_action",
+        episode_progress=0.25,
+        phase_fraction=0.5,
+        risk_lambda=2.0,
+    )
+    late, _ = select_planning_sample(
+        candidates,
+        strategy="phase_gated_action",
+        episode_progress=0.75,
+        phase_fraction=0.5,
+        risk_lambda=2.0,
+    )
+    assert early == 1
+    assert late == 0
+
+
+def test_disagreement_requery_shortens_only_ambiguous_chunk() -> None:
+    candidates = [
+        sample_with_action_copies(0.8, first_std=1.0, later_std=1.0),
+        sample_with_action_copies(0.7, first_std=0.0, later_std=0.0),
+    ]
+    selected, diagnostics = select_planning_sample(
+        candidates,
+        strategy="disagreement_requery_action",
+        risk_lambda=2.0,
+        open_loop_steps=16,
+        short_open_loop_steps=8,
+    )
+
+    assert selected == 1
+    assert diagnostics["planning_requery_triggered"] is True
+    assert diagnostics["planning_selected_open_loop_steps"] == 8.0
+
+
+def test_horizon_only_requery_preserves_max_value_candidate() -> None:
+    candidates = [
+        sample_with_action_copies(0.8, first_std=1.0, later_std=1.0),
+        sample_with_action_copies(0.7, first_std=0.0, later_std=0.0),
+    ]
+    selected, diagnostics = select_planning_sample(
+        candidates,
+        strategy="max_value_disagreement_requery",
+        risk_lambda=2.0,
+        open_loop_steps=16,
+        short_open_loop_steps=8,
+    )
+
+    assert selected == 0
+    assert diagnostics["max_value_selected"] is True
+    assert diagnostics["risk_candidate_sample_idx"] == 1.0
+    assert diagnostics["planning_effective_strategy"] == "max_value"
+    assert diagnostics["planning_requery_triggered"] is True
+    assert diagnostics["planning_selected_open_loop_steps"] == 8.0
+
+
+def test_horizon_only_requery_keeps_full_chunk_without_disagreement() -> None:
+    candidates = [
+        sample_with_action_copies(0.8, first_std=0.0, later_std=0.0),
+        sample_with_action_copies(0.7, first_std=1.0, later_std=1.0),
+    ]
+    selected, diagnostics = select_planning_sample(
+        candidates,
+        strategy="max_value_disagreement_requery",
+        risk_lambda=2.0,
+        open_loop_steps=16,
+        short_open_loop_steps=8,
+    )
+
+    assert selected == 0
+    assert diagnostics["planning_requery_triggered"] is False
+    assert diagnostics["planning_selected_open_loop_steps"] == 16.0
+
+
+def test_frozen_proprio_error_surrogate_matches_its_center_point() -> None:
+    predicted = predict_future_proprio_error(
+        *np.exp(PROPRIO_ERROR_SURROGATE_V1_LOG_MEANS)
+    )
+
+    assert np.isclose(predicted, np.exp(PROPRIO_ERROR_SURROGATE_V1_INTERCEPT))
+
+
+def test_surrogate_gate_changes_selection_and_horizon_only_on_alarm() -> None:
+    candidates = [
+        sample_with_action_copies(0.8, first_std=1.0, later_std=1.0),
+        sample_with_action_copies(0.7, first_std=0.0, later_std=0.0),
+    ]
+    selected, diagnostics = select_planning_sample(
+        candidates,
+        strategy="surrogate_gated_requery_action",
+        risk_lambda=2.0,
+        surrogate_error_threshold=0.0,
+        short_open_loop_steps=8,
+    )
+    assert selected == 1
+    assert diagnostics["planning_surrogate_alarm"] is True
+    assert diagnostics["planning_selected_open_loop_steps"] == 8.0
+
+    selected, diagnostics = select_planning_sample(
+        candidates,
+        strategy="surrogate_gated_requery_action",
+        risk_lambda=2.0,
+        surrogate_error_threshold=1e9,
+        short_open_loop_steps=8,
+    )
+    assert selected == 0
+    assert diagnostics["planning_surrogate_alarm"] is False
+    assert diagnostics["planning_selected_open_loop_steps"] == 16.0
+
+
+def test_phase_surrogate_keeps_early_penalty_and_requeries_on_late_alarm() -> None:
+    candidates = [
+        sample_with_action_copies(0.8, first_std=1.0, later_std=1.0),
+        sample_with_action_copies(0.7, first_std=0.0, later_std=0.0),
+    ]
+    early, early_diagnostics = select_planning_sample(
+        candidates,
+        strategy="phase_surrogate_requery_action",
+        risk_lambda=2.0,
+        episode_progress=0.2,
+        phase_fraction=0.3,
+        surrogate_error_threshold=1e9,
+    )
+    late, late_diagnostics = select_planning_sample(
+        candidates,
+        strategy="phase_surrogate_requery_action",
+        risk_lambda=2.0,
+        episode_progress=0.8,
+        phase_fraction=0.3,
+        surrogate_error_threshold=0.0,
+    )
+
+    assert early == 1
+    assert early_diagnostics["planning_selected_open_loop_steps"] == 16.0
+    assert late == 1
+    assert late_diagnostics["planning_selected_open_loop_steps"] == 8.0
+
+
+def test_phase_requery_only_shortens_early_disagreement() -> None:
+    candidates = [
+        sample_with_action_copies(0.8, first_std=1.0, later_std=1.0),
+        sample_with_action_copies(0.7, first_std=0.0, later_std=0.0),
+    ]
+    early, early_diagnostics = select_planning_sample(
+        candidates,
+        strategy="phase_requery_action",
+        risk_lambda=2.0,
+        episode_progress=0.2,
+        phase_fraction=0.3,
+    )
+    late, late_diagnostics = select_planning_sample(
+        candidates,
+        strategy="phase_requery_action",
+        risk_lambda=2.0,
+        episode_progress=0.8,
+        phase_fraction=0.3,
+    )
+
+    assert early == 1
+    assert early_diagnostics["planning_requery_triggered"] is True
+    assert early_diagnostics["planning_selected_open_loop_steps"] == 8.0
+    assert late == 0
+    assert late_diagnostics["planning_requery_triggered"] is False
+    assert late_diagnostics["planning_selected_open_loop_steps"] == 16.0
+
+
+def test_surrogate_horizon_keeps_action_ranking_without_alarm() -> None:
+    candidates = [
+        sample_with_action_copies(0.8, first_std=1.0, later_std=1.0),
+        sample_with_action_copies(0.7, first_std=0.0, later_std=0.0),
+    ]
+    selected, diagnostics = select_planning_sample(
+        candidates,
+        strategy="surrogate_horizon_action",
+        risk_lambda=2.0,
+        surrogate_error_threshold=1e9,
+    )
+
+    assert selected == 1
+    assert diagnostics["planning_surrogate_alarm"] is False
+    assert diagnostics["planning_requery_triggered"] is False
+    assert diagnostics["planning_selected_open_loop_steps"] == 16.0
+
+
+def test_surrogate_disagreement_requires_both_conditions_to_requery() -> None:
+    disagreeing = [
+        sample_with_action_copies(0.8, first_std=1.0, later_std=1.0),
+        sample_with_action_copies(0.7, first_std=0.0, later_std=0.0),
+    ]
+    _, no_alarm = select_planning_sample(
+        disagreeing,
+        strategy="surrogate_disagreement_requery_action",
+        risk_lambda=2.0,
+        surrogate_error_threshold=1e9,
+    )
+    _, alarm_and_disagreement = select_planning_sample(
+        disagreeing,
+        strategy="surrogate_disagreement_requery_action",
+        risk_lambda=2.0,
+        surrogate_error_threshold=0.0,
+    )
+    _, alarm_without_disagreement = select_planning_sample(
+        [sample_with_action_copies(0.8, first_std=0.0, later_std=0.0)],
+        strategy="surrogate_disagreement_requery_action",
+        risk_lambda=2.0,
+        surrogate_error_threshold=0.0,
+    )
+
+    assert no_alarm["planning_requery_triggered"] is False
+    assert alarm_and_disagreement["planning_requery_triggered"] is True
+    assert alarm_and_disagreement["planning_selected_open_loop_steps"] == 8.0
+    assert alarm_without_disagreement["planning_surrogate_alarm"] is True
+    assert alarm_without_disagreement["planning_requery_triggered"] is False
+    assert alarm_without_disagreement["planning_selected_open_loop_steps"] == 16.0
