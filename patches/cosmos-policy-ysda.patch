+def build_parser() -> argparse.ArgumentParser:
+    parser = argparse.ArgumentParser(description=__doc__)
+    subparsers = parser.add_subparsers(dest="command", required=True)
+
+    def add_intervention_args(subparser: argparse.ArgumentParser) -> None:
+        subparser.add_argument(
+            "--intervention-mode",
+            choices=["none", "zero_all", "zero_motion", "gripper", "scale", "bias"],
+            default="none",
+            help="Deterministic action edit for controlled-failure experiments",
+        )
+        subparser.add_argument("--intervention-start-t", type=int, default=0)
+        subparser.add_argument("--intervention-end-t", type=int, default=-1, help="-1 means no end time")
+        subparser.add_argument("--intervention-start-query", type=int, default=-1, help="-1 means no query bound")
+        subparser.add_argument("--intervention-end-query", type=int, default=-1, help="-1 means no query bound")
+        subparser.add_argument("--intervention-gripper", type=float, default=1.0)
+        subparser.add_argument("--intervention-scale", type=float, default=0.0)
+        subparser.add_argument("--intervention-bias", default="", help="Comma-separated 7D action bias for mode=bias")
+
+    def add_planning_args(subparser: argparse.ArgumentParser) -> None:
+        subparser.add_argument(
+            "--planning-strategy",
+            choices=[
+                "first",
+                "max_value",
+                "max_value_replay",
+                "risk_aware_action",
+                "risk_aware_value",
