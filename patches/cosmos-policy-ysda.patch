+def patch_cuda_trunc_normal_for_blackwell() -> None:
+    """Work around torch 2.7 CUDA trunc_normal_ failures on RTX 50-series GPUs."""
+    global _TRUNC_NORMAL_PATCHED
+    if _TRUNC_NORMAL_PATCHED or not torch.cuda.is_available():
+        return
+
+    major, _minor = torch.cuda.get_device_capability()
+    if major < 12:
+        return
+
+    def safe_trunc_normal_(tensor, mean=0.0, std=1.0, a=-2.0, b=2.0, generator=None):
+        if tensor.is_cuda and tensor.dtype is torch.float32:
+            with torch.no_grad():
+                cpu_tensor = torch.empty(tensor.shape, dtype=tensor.dtype, device="cpu")
+                _ORIGINAL_TRUNC_NORMAL(cpu_tensor, mean=mean, std=std, a=a, b=b)
+                tensor.copy_(cpu_tensor.to(device=tensor.device, non_blocking=True))
+            return tensor
+        return _ORIGINAL_TRUNC_NORMAL(tensor, mean=mean, std=std, a=a, b=b, generator=generator)
+
+    torch.nn.init.trunc_normal_ = safe_trunc_normal_
+    _TRUNC_NORMAL_PATCHED = True
+
 
