--- /dev/null
+++ b/tests/test_safety_signals.py
@@ -0,0 +1,140 @@
+from __future__ import annotations
+
+from types import SimpleNamespace
+
+import numpy as np
+
+from cosmos_policy.experiments.robot.libero.safety_signals import (
+    SafetySignalTracker,
+    has_official_safety_violation,
+    official_safety_costs,
+)
+
+
+class FakeObjectState:
+    object_state_type = "object"
+    is_fixture = False
+
+    def __init__(self, position):
+        self.position = np.asarray(position, dtype=np.float64)
+
+    def get_geom_state(self):
+        return {"pos": self.position}
+
+
+class FakeTaskEnv:
+    control_freq = 20
+
+    def __init__(self):
+        self.goal = False
+        self.parsed_problem = {
+            "goal_state": [("on", "target", "plate")],
+            "obj_of_interest": ["target", "plate"],
+        }
+        self.object_states_dict = {
+            "target": FakeObjectState([0.0, 0.0, 0.80]),
+            "plate": FakeObjectState([0.2, 0.0, 0.80]),
+            "distractor": FakeObjectState([-0.2, 0.0, 0.80]),
+        }
+        self.sim = SimpleNamespace(
+            data=SimpleNamespace(ncon=0),
+            model=SimpleNamespace(),
+        )
+
+    def _eval_predicate(self, _state):
+        return self.goal
+
+
+def make_tracker():
+    task_env = FakeTaskEnv()
+    wrapped = SimpleNamespace(env=task_env)
+    tracker = SafetySignalTracker(
+        wrapped,
+        {"robot0_eef_pos": np.array([0.0, 0.0, 0.85])},
+    )
+    return task_env, tracker
+
+
+def test_official_safety_cost_extraction():
+    info = {"cost": {"CheckRobotContact": 1, "Fall": 0}}
+    assert official_safety_costs(info) == {"CheckRobotContact": 1.0}
+    assert has_official_safety_violation(info)
+    assert not has_official_safety_violation({"cost": {"Fall": 0}})
+
+
+def test_target_drop_candidate_and_query_metrics():
+    env, tracker = make_tracker()
+    marker = tracker.mark_query_start()
+
+    env.object_states_dict["target"].position[:] = [0.0, 0.0, 0.89]
+    tracker.observe(
+        {"robot0_eef_pos": np.array([0.0, 0.0, 0.90])},
+        np.ones(7),
+        t=1,
+    )
+    env.object_states_dict["target"].position[:] = [0.0, 0.0, 0.81]
+    tracker.observe(
+        {"robot0_eef_pos": np.array([0.4, 0.0, 0.90])},
+        -np.ones(7),
+        t=2,
+    )
+
+    query = tracker.query_summary(marker)
+    episode = tracker.episode_summary(False, final_t=2, max_steps=10)
+    assert query["observed_target_drop_candidate"] == 1.0
+    assert query["observed_action_sign_flip_rate"] == 1.0
+    assert episode["failure_type"] == "target_drop_candidate"
+    assert episode["failure_event_t"] == 2
+
+
+def test_wrong_object_and_official_violation_priority():
+    env, tracker = make_tracker()
+    env.object_states_dict["distractor"].position[:] = [-0.2, 0.0, 0.94]
+    tracker.observe(
+        {"robot0_eef_pos": np.array([0.0, 0.0, 0.85])},
+        np.zeros(7),
+        t=1,
+        info={"cost": {"Collide": 1}},
+    )
+
+    episode = tracker.episode_summary(False, final_t=1, max_steps=10, safety_terminated=True)
+    assert episode["wrong_object_interaction_candidate"]
+    assert episode["official_safety_violation"]
+    assert episode["failure_type"] == "safety_constraint_violation"
+    assert episode["official_safety_violation_t"] == 1
+
+
+def test_success_overrides_failure_candidates():
+    env, tracker = make_tracker()
+    env.object_states_dict["target"].position[:] = [0.0, 0.0, 0.90]
+    tracker.observe(
+        {"robot0_eef_pos": np.array([0.0, 0.0, 0.91])},
+        np.zeros(7),
+        t=1,
+    )
+    env.object_states_dict["target"].position[:] = [0.2, 0.0, 0.80]
+    env.goal = True
+    tracker.observe(
+        {"robot0_eef_pos": np.array([0.4, 0.0, 0.90])},
+        np.zeros(7),
+        t=2,
+        task_success=True,
+    )
+
+    episode = tracker.episode_summary(True, final_t=2, max_steps=10)
+    assert episode["failure_type"] == "success"
+    assert episode["safe_task_success"]
+
+
+def test_stationary_failed_episode_is_deadlock_candidate():
+    _env, tracker = make_tracker()
+    for step in range(1, 9):
+        tracker.observe(
+            {"robot0_eef_pos": np.array([0.0, 0.0, 0.85])},
+            np.zeros(7),
+            t=step,
+        )
+
+    episode = tracker.episode_summary(False, final_t=8, max_steps=8)
