+def save_trace_video(
+    frames: Sequence[np.ndarray],
+    video_dir: Path,
+    trace: pd.DataFrame,
+    fps: int = 30,
+) -> Optional[Path]:
+    """Save an episode replay video captured during the exact trace rollout."""
+    if len(frames) == 0 or len(trace) == 0:
+        return None
+
+    first = trace.iloc[0]
+    success = bool(first["success"]) if "success" in trace else False
+    final_t = int(first["final_t"]) if "final_t" in trace else int(len(frames))
+    expected_frames = int(trace["executed_steps"].sum()) if "executed_steps" in trace else int(len(frames))
+    task_name = _sanitize_filename_part(first.get("task_description", "task"), max_len=50)
+    filename = (
+        f"{_sanitize_filename_part(first.get('suite', 'suite'), max_len=40)}"
+        f"__task{int(first.get('task_id', -1))}"
+        f"__init{int(first.get('init_state_id', -1))}"
+        f"__pair{int(first.get('pair_id', -1))}"
+        f"__rollout{int(first.get('rollout_id', first.get('episode_id', -1)))}"
+        f"__seed{int(first.get('rollout_seed', first.get('base_seed', -1)))}"
+        f"__success{success}"
+        f"__t{final_t}"
+        f"__frames{len(frames)}of{expected_frames}"
+        f"__{task_name}.mp4"
+    )
+
+    video_dir.mkdir(parents=True, exist_ok=True)
+    video_path = video_dir / filename
+    with imageio.get_writer(video_path, fps=fps, macro_block_size=1) as writer:
+        for frame in frames:
+            writer.append_data(np.asarray(frame, dtype=np.uint8))
+    return video_path
