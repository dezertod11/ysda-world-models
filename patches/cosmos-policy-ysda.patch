+# SPDX-License-Identifier: Apache-2.0
+"""Uncertainty probes for Cosmos Policy LIBERO rollouts.
+
+The functions here operate on the dictionaries returned by
+``cosmos_policy.experiments.robot.cosmos_utils.get_action``.  They are kept
+separate from the notebook so the same metrics can be reused in eval scripts.
+"""
+
+from __future__ import annotations
+
+from itertools import combinations
+from typing import Any, Dict, Iterable, List, Optional, Sequence, Tuple
+
+import numpy as np
+
+from cosmos_policy.constants import ACTION_DIM, NUM_ACTIONS_CHUNK, PROPRIO_DIM
+from cosmos_policy.experiments.robot.cosmos_utils import (
+    get_action,
+    get_future_state_prediction,
+    get_value_prediction,
+)
+from cosmos_policy.experiments.robot.libero.vfd_metrics import summarize_flow_path_dispersion
+
+
+def _to_numpy(x: Any) -> np.ndarray:
+    """Convert torch / list / scalar-like objects to numpy."""
+    if hasattr(x, "detach"):
+        x = x.detach().float().cpu().numpy()
+    return np.asarray(x)
+
+
+def _safe_float(x: Any) -> float:
+    if x is None:
+        return float("nan")
+    if hasattr(x, "detach"):
+        x = x.detach().float().cpu().item()
+    return float(x)
+
+
+def _latent_frame(generated_latent: Any, latent_idx: int) -> np.ndarray:
+    """Return latent frame as ``(B, C, H, W)`` numpy array."""
+    latent = _to_numpy(generated_latent)
+    if latent_idx < 0:
+        latent_idx = latent.shape[2] + latent_idx
+    return latent[:, :, latent_idx, :, :]
+
+
+def repeated_vectors_from_latent(
+    generated_latent: Any,
+    latent_idx: int,
+    vector_dim: int,
+) -> np.ndarray:
+    """Read repeated vectors from a non-image latent frame.
+
+    During latent injection, low-dimensional vectors are flattened, repeated,
+    and reshaped into a full latent volume.  This function reverses only the
+    repetition/reshape part and returns every complete copy found in the latent.
+
+    Returns:
+        Array with shape ``(B, num_copies, vector_dim)``.
+    """
+    frame = _latent_frame(generated_latent, latent_idx)
+    flat = frame.reshape(frame.shape[0], -1)
+    num_copies = flat.shape[1] // vector_dim
+    if num_copies < 1:
+        raise ValueError(f"latent frame has {flat.shape[1]} elements, fewer than vector_dim={vector_dim}")
+    return flat[:, : num_copies * vector_dim].reshape(frame.shape[0], num_copies, vector_dim)
+
+
+def extract_future_proprio_from_sample(sample: Dict[str, Any], proprio_dim: int = PROPRIO_DIM) -> Optional[np.ndarray]:
+    """Extract normalized future proprio from a generated sample, if present."""
+    idx = sample.get("latent_indices", {}).get("future_proprio_latent_idx", -1)
+    generated_latent = sample.get("future_state_generated_latent", sample.get("generated_latent"))
+    if idx is None or idx < 0 or generated_latent is None:
+        return None
+    copies = repeated_vectors_from_latent(generated_latent, idx, proprio_dim)
+    return copies.mean(axis=1)
+
+
+def latent_internal_consistency(
+    sample: Dict[str, Any],
+    action_shape: Tuple[int, int] = (NUM_ACTIONS_CHUNK, ACTION_DIM),
+    proprio_dim: int = PROPRIO_DIM,
+) -> Dict[str, float]:
+    """Measure disagreement among repeated copies inside one generated latent.
+
+    Smaller values mean the model produced a latent frame that is more
+    self-consistent with the latent-injection representation.
+    """
+    metrics: Dict[str, float] = {}
+    latent_indices = sample.get("latent_indices", {})
+    action_latent = sample.get("action_generated_latent", sample.get("generated_latent"))
+    future_state_latent = sample.get("future_state_generated_latent", sample.get("generated_latent"))
+    value_latent = sample.get("value_generated_latent", sample.get("generated_latent"))
+    if action_latent is None:
+        return metrics
+
+    action_idx = latent_indices.get("action_latent_idx", -1)
+    if action_idx is not None and action_idx >= 0:
+        action_dim = action_shape[0] * action_shape[1]
+        action_copies = repeated_vectors_from_latent(action_latent, action_idx, action_dim)
+        action_copies = action_copies.reshape(
+            action_copies.shape[0],
+            action_copies.shape[1],
+            action_shape[0],
+            action_shape[1],
+        )
+        action_copy_std = action_copies.std(axis=1)
+        metrics["latent_action_copy_std_mean"] = float(action_copy_std.mean())
+        metrics["latent_action_copy_std_max"] = float(action_copy_std.max())
+        metrics["latent_action_first_step_copy_l2_std"] = float(
+            np.linalg.norm(action_copy_std[:, 0, :], axis=-1).mean()
+        )
+
+    future_proprio_idx = latent_indices.get("future_proprio_latent_idx", -1)
+    if future_state_latent is not None and future_proprio_idx is not None and future_proprio_idx >= 0:
+        proprio_copies = repeated_vectors_from_latent(future_state_latent, future_proprio_idx, proprio_dim)
+        proprio_copy_std = proprio_copies.std(axis=1)
+        metrics["latent_future_proprio_copy_std_mean"] = float(proprio_copy_std.mean())
+        metrics["latent_future_proprio_copy_std_max"] = float(proprio_copy_std.max())
+
+    value_idx = latent_indices.get("value_latent_idx", -1)
+    if value_latent is not None and value_idx is not None and value_idx != -1:
+        value_frame = _latent_frame(value_latent, value_idx)
+        flat_value = value_frame.reshape(value_frame.shape[0], -1)
+        metrics["latent_value_element_std_mean"] = float(flat_value.std(axis=1).mean())
+        metrics["latent_value_element_std_max"] = float(flat_value.std(axis=1).max())
+
+    return metrics
+
+
+def _pairwise_action_l2(actions: np.ndarray) -> float:
+    if actions.shape[0] < 2:
+        return float("nan")
+    distances = []
+    for i, j in combinations(range(actions.shape[0]), 2):
+        distances.append(np.linalg.norm(actions[i] - actions[j], axis=-1).mean())
+    return float(np.mean(distances))
+
+
+def _image_std_metrics(samples: Sequence[Dict[str, Any]], image_key: str, prefix: str) -> Dict[str, float]:
+    images = []
+    for sample in samples:
+        future = sample.get("future_image_predictions", {})
+        image = future.get(image_key)
+        if image is not None:
+            images.append(_to_numpy(image).astype(np.float32))
+    if len(images) < 2:
+        return {}
+    stack = np.stack(images)
+    pixel_std = stack.std(axis=0)
+    return {
+        f"{prefix}_pixel_std_mean": float(pixel_std.mean()),
+        f"{prefix}_pixel_std_p95": float(np.percentile(pixel_std, 95)),
+        f"{prefix}_pixel_std_max": float(pixel_std.max()),
+    }
+
+
+def _latent_across_seed_std(
+    samples: Sequence[Dict[str, Any]],
+    latent_index_name: str,
+    metric_name: str,
+) -> Dict[str, float]:
+    frames = []
+    latent_key = {
+        "action_latent_idx": "action_generated_latent",
+        "future_proprio_latent_idx": "future_state_generated_latent",
+        "value_latent_idx": "value_generated_latent",
+    }.get(latent_index_name, "generated_latent")
+    for sample in samples:
+        generated_latent = sample.get(latent_key, sample.get("generated_latent"))
+        idx = sample.get("latent_indices", {}).get(latent_index_name, -1)
+        if generated_latent is not None and idx is not None and idx >= 0:
+            frames.append(_latent_frame(generated_latent, idx).astype(np.float32))
+    if len(frames) < 2:
+        return {}
+    std = np.stack(frames).std(axis=0)
+    return {
+        f"{metric_name}_across_seed_std_mean": float(std.mean()),
+        f"{metric_name}_across_seed_std_p95": float(np.percentile(std, 95)),
+        f"{metric_name}_across_seed_std_max": float(std.max()),
+    }
+
+
+def summarize_action_ensemble(
+    samples: Sequence[Dict[str, Any]],
+    action_dim: int = ACTION_DIM,
+    proprio_dim: int = PROPRIO_DIM,
+) -> Dict[str, float]:
+    """Summarize uncertainty from multiple ``get_action`` samples."""
+    if len(samples) == 0:
+        raise ValueError("samples must contain at least one get_action output")
+
+    actions = np.stack([_to_numpy(sample["actions"]).astype(np.float32) for sample in samples])
+    values = np.array([_safe_float(sample.get("value_prediction")) for sample in samples], dtype=np.float32)
+
+    action_std = actions.std(axis=0)
+    metrics: Dict[str, float] = {
+        "num_samples": float(len(samples)),
+        "action_std_mean": float(action_std.mean()),
+        "action_std_max": float(action_std.max()),
+        "action_first_step_l2_std": float(np.linalg.norm(action_std[0, : action_dim - 1])),
+        "action_xyz_std_mean": float(action_std[:, :3].mean()),
+        "action_rot_std_mean": float(action_std[:, 3:6].mean()) if action_dim >= 6 else float("nan"),
+        "action_gripper_std_mean": float(action_std[:, -1].mean()),
+        "action_pairwise_l2_mean": _pairwise_action_l2(actions),
+        "value_mean": float(np.nanmean(values)),
+        "value_std": float(np.nanstd(values)),
+        "value_range": float(np.nanmax(values) - np.nanmin(values)),
+    }
+
+    future_proprios = [
+        future_proprio
+        for future_proprio in (extract_future_proprio_from_sample(sample, proprio_dim) for sample in samples)
+        if future_proprio is not None
+    ]
+    if len(future_proprios) >= 2:
+        future_proprio_std = np.stack(future_proprios).std(axis=0)
+        metrics["future_proprio_std_mean"] = float(future_proprio_std.mean())
+        metrics["future_proprio_std_max"] = float(future_proprio_std.max())
+
+    metrics.update(_image_std_metrics(samples, "future_image", "future_image"))
+    metrics.update(_image_std_metrics(samples, "future_wrist_image", "future_wrist"))
+    metrics.update(_latent_across_seed_std(samples, "action_latent_idx", "latent_action"))
+    metrics.update(_latent_across_seed_std(samples, "future_proprio_latent_idx", "latent_future_proprio"))
+    metrics.update(_latent_across_seed_std(samples, "value_latent_idx", "latent_value"))
+
+    internal_metrics: Dict[str, List[float]] = {}
+    for sample in samples:
+        for key, value in latent_internal_consistency(sample, proprio_dim=proprio_dim).items():
+            internal_metrics.setdefault(key, []).append(value)
+    for key, values_for_key in internal_metrics.items():
+        metrics[f"{key}_mean_over_samples"] = float(np.mean(values_for_key))
+        metrics[f"{key}_max_over_samples"] = float(np.max(values_for_key))
+
+    denoising_traces = [
+        sample["denoising_trace"]
+        for sample in samples
+        if sample.get("denoising_trace") is not None
+    ]
+    if len(denoising_traces) >= 2:
+        metrics.update(summarize_flow_path_dispersion(denoising_traces))
+
+    return metrics
+
+
+def sample_action_ensemble(
+    cfg: Any,
+    model: Any,
+    dataset_stats: Dict[str, Any],
+    observation: Dict[str, Any],
+    task_description: Any,
+    seeds: Iterable[int] = (195, 196, 197, 198),
+    num_denoising_steps_action: Optional[int] = None,
+    generate_future_state_and_value_in_parallel: bool = True,
+    record_denoising_trace: bool = False,
+    prediction_mode: Optional[str] = None,
+    num_denoising_steps_future_state: Optional[int] = None,
+    num_denoising_steps_value: Optional[int] = None,
+    num_future_state_samples: Optional[int] = None,
+    num_value_samples: Optional[int] = None,
+) -> Tuple[List[Dict[str, Any]], Dict[str, float]]:
+    """Run ``get_action`` multiple times and return raw samples plus metrics."""
+    samples = []
+    steps = num_denoising_steps_action or cfg.num_denoising_steps_action
+    if prediction_mode is None:
+        prediction_mode = (
+            "parallel"
+            if generate_future_state_and_value_in_parallel
+            else "autoregressive"
+        )
+    prediction_mode = prediction_mode.lower()
+    if prediction_mode not in {"parallel", "autoregressive"}:
+        raise ValueError(f"Unknown prediction_mode={prediction_mode}")
+
+    future_steps = num_denoising_steps_future_state or cfg.num_denoising_steps_future_state
+    value_steps = num_denoising_steps_value or cfg.num_denoising_steps_value
+    future_samples = num_future_state_samples or cfg.num_future_state_predictions_in_ensemble
+    value_samples = num_value_samples or cfg.num_value_predictions_in_ensemble
+    for seed in seeds:
+        sample = get_action(
+            cfg,
+            model,
+            dataset_stats,
+            observation,
+            task_description,
+            seed=int(seed),
+            randomize_seed=False,
+            num_denoising_steps_action=steps,
+            generate_future_state_and_value_in_parallel=prediction_mode == "parallel",
+            record_denoising_trace=record_denoising_trace,
+        )
+        sample["action_generated_latent"] = sample["generated_latent"]
+
+        if prediction_mode == "autoregressive":
+            indices = sample["latent_indices"]
+            future = get_future_state_prediction(
+                cfg,
+                model=model,
+                data_batch=sample["data_batch"],
+                generated_latent_with_action=sample["generated_latent"],
+                orig_clean_latent_frames=sample["orig_clean_latent_frames"],
+                future_proprio_latent_idx=indices["future_proprio_latent_idx"],
+                future_wrist_image_latent_idx=indices["future_wrist_image_latent_idx"],
+                future_wrist_image2_latent_idx=indices["future_wrist_image2_latent_idx"],
+                future_image_latent_idx=indices["future_image_latent_idx"],
+                future_image2_latent_idx=indices["future_image2_latent_idx"],
+                seed=int(seed),
+                randomize_seed=False,
+                num_denoising_steps_future_state=future_steps,
+                use_ensemble_future_state_predictions=future_samples > 1,
+                num_future_state_predictions_in_ensemble=future_samples,
+                future_state_ensemble_aggregation_scheme=cfg.future_state_ensemble_aggregation_scheme,
+            )
+            value = get_value_prediction(
+                cfg,
+                model=model,
+                data_batch=sample["data_batch"],
+                future_state_samples_list=future["future_state_samples_list"],
+                seed=int(seed),
+                randomize_seed=False,
+                num_denoising_steps_value=value_steps,
+                use_ensemble_value_predictions=value_samples > 1,
+                num_value_predictions_in_ensemble=value_samples,
+            )
+            sample["future_image_predictions"] = future["future_image_predictions"]
+            sample["value_prediction"] = value["value_prediction"]
+            sample["future_state_generated_latent"] = future["future_state_samples_list"][-1]
+            if value.get("generated_value_samples"):
+                sample["value_generated_latent"] = value["generated_value_samples"][-1]
+
+        sample["prediction_mode"] = prediction_mode
+        samples.append(sample)
+    return samples, summarize_action_ensemble(samples)
