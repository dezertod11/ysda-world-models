+from __future__ import annotations
+
+import copy
+
+import numpy as np
+import pytest
+import torch
+
+from cosmos_policy.experiments.robot.libero.vfd_metrics import (
+    DenoisingTraceRecorder,
+    compute_blockwise_vfd,
+    edm_x0_to_flow_velocity,
+    summarize_flow_path_dispersion,
+)
+
+
+def test_edm_x0_prediction_maps_to_flow_velocity() -> None:
+    x0 = torch.tensor([[[[[1.0]]], [[[2.0]]]]])
+    epsilon = torch.tensor([[[[[3.0]]], [[[5.0]]]]])
+    sigma = torch.tensor([2.0])
+    noisy_state = x0 + sigma.reshape(1, 1, 1, 1, 1) * epsilon
+
+    velocity = edm_x0_to_flow_velocity(noisy_state, x0, sigma)
+
+    torch.testing.assert_close(velocity, epsilon - x0)
+
+
+def test_sampler_trace_does_not_change_output() -> None:
+    try:
+        from cosmos_policy.modules.cosmos_sampler import CosmosPolicySampler
+    except Exception as error:
+        pytest.skip(f"Cosmos sampler runtime dependencies are unavailable: {error}")
+
+    sampler = CosmosPolicySampler()
+    noisy_state = torch.linspace(-2.0, 2.0, 32).reshape(1, 2, 2, 2, 4)
+
+    def x0_fn(x: torch.Tensor, sigma: torch.Tensor) -> torch.Tensor:
+        sigma_scale = sigma.reshape(-1, 1, 1, 1, 1)
+        return x / (1.0 + sigma_scale)
+
+    baseline = sampler(x0_fn, noisy_state.clone(), num_steps=5, solver_option="2ab")
+    recorder = DenoisingTraceRecorder({"first": 0, "second": 1})
+    traced = sampler(
+        x0_fn,
+        noisy_state.clone(),
+        num_steps=5,
+        solver_option="2ab",
+        denoiser_callback_fns=[recorder],
+    )
+    trace = recorder.as_dict()
+
+    assert torch.equal(baseline, traced)
+    assert trace["sigmas"].shape == (4,)
+    assert trace["block_velocities"]["first"].shape[0] == 4
+    assert np.all(trace["sigmas"] > 0)
+
+
+def test_identical_stochastic_traces_have_zero_path_dispersion() -> None:
+    trace = {
+        "sigmas": np.array([3.0, 1.0, 0.25]),
+        "block_velocities": {
+            "action": np.arange(24, dtype=np.float32).reshape(3, 1, 2, 2, 2),
+        },
+    }
+
+    metrics = summarize_flow_path_dispersion([trace, copy.deepcopy(trace)])
+
+    assert metrics["flow_path_dispersion_action_mse"] == 0.0
+    assert metrics["flow_path_dispersion_action_vfd_weighted"] == 0.0
+
+
+def test_identical_model_copies_have_zero_exact_vfd() -> None:
+    rng = np.random.default_rng(7)
+    trajectories = rng.normal(size=(2, 3, 4)).astype(np.float32)
+    cross_grid = np.empty((2, 2, 3, 4), dtype=np.float32)
+    for trajectory_index in range(2):
+        cross_grid[trajectory_index, 0] = trajectories[trajectory_index]
+        cross_grid[trajectory_index, 1] = trajectories[trajectory_index]
+
+    result = compute_blockwise_vfd({"action": cross_grid}, np.array([4.0, 1.0, 0.2]))
+
+    assert result["action"] == 0.0
+
+
+def test_exact_vfd_is_invariant_to_ensemble_permutation() -> None:
+    rng = np.random.default_rng(11)
+    velocities = rng.normal(size=(3, 3, 4, 2, 3)).astype(np.float32)
+    sigmas = np.array(
+        [
+            [8.0, 2.0, 0.5, 0.1],
+            [7.0, 1.8, 0.4, 0.08],
+            [9.0, 2.2, 0.6, 0.12],
+        ]
+    )
+    permutation = np.array([2, 0, 1])
+
+    original = compute_blockwise_vfd({"value": velocities}, sigmas)["value"]
+    permuted = compute_blockwise_vfd(
+        {"value": velocities[permutation][:, permutation]},
+        sigmas[permutation],
+    )["value"]
+
+    np.testing.assert_allclose(original, permuted, rtol=1e-7, atol=1e-7)
+
+
+def test_blockwise_vfd_is_dimension_normalized() -> None:
+    compact = np.zeros((2, 2, 1, 1), dtype=np.float32)
+    compact[0, 1, 0, 0] = 2.0
+    compact[1, 0, 0, 0] = 2.0
+    repeated = np.repeat(compact, repeats=128, axis=-1)
+
+    result = compute_blockwise_vfd(
+        {"compact": compact, "repeated": repeated},
+        np.array([1.0]),
+    )
+
+    np.testing.assert_allclose(result["compact"], result["repeated"])
+
+
+def test_terminal_sigma_is_excluded_from_vfd() -> None:
+    velocities = np.zeros((2, 2, 2, 1), dtype=np.float32)
+    velocities[0, 1, 1, 0] = 1000.0
+    velocities[1, 0, 1, 0] = -1000.0
+
+    result = compute_blockwise_vfd(
+        {"action": velocities},
+        np.array([1.0, 0.0]),
+        sigma_floor=1e-8,
+    )
+
+    assert result["action"] == 0.0
