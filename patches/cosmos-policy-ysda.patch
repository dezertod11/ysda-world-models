+def _global_ssim(pred: np.ndarray, actual: np.ndarray) -> float:
+    """Small dependency-free global SSIM approximation for quick ranking."""
+    pred = pred.astype(np.float64)
+    actual = actual.astype(np.float64)
+    c1 = (0.01 * 255.0) ** 2
+    c2 = (0.03 * 255.0) ** 2
+    mux = pred.mean()
+    muy = actual.mean()
+    varx = pred.var()
+    vary = actual.var()
+    cov = ((pred - mux) * (actual - muy)).mean()
+    denom = (mux**2 + muy**2 + c1) * (varx + vary + c2)
+    if denom == 0:
+        return float("nan")
+    return float(((2 * mux * muy + c1) * (2 * cov + c2)) / denom)
+
+
+def image_prediction_error_metrics(predicted: Any, actual: np.ndarray, prefix: str) -> Dict[str, float]:
+    """Compare predicted future RGB image with actual future observation image."""
+    if predicted is None or actual is None:
+        return {}
+    pred = _to_numpy_array(predicted)
+    if pred.ndim == 4:
+        pred = pred[0]
+    if pred.dtype != np.uint8:
+        pred = np.clip(pred, 0, 255).astype(np.uint8)
+    actual_resized = _resize_like(actual, pred).astype(np.float32)
+    pred = pred.astype(np.float32)
+    diff = pred - actual_resized
+    mse = float(np.mean(diff**2))
+    mae = float(np.mean(np.abs(diff)))
+    psnr = float(20.0 * np.log10(255.0 / np.sqrt(mse))) if mse > 0 else float("inf")
+    return {
+        f"{prefix}_mse": mse,
+        f"{prefix}_mae": mae,
+        f"{prefix}_psnr": psnr,
+        f"{prefix}_ssim_global": _global_ssim(pred, actual_resized),
+    }
+
+
+def proprio_prediction_error_metrics(
+    predicted_normalized: Optional[np.ndarray],
+    actual_raw: np.ndarray,
+    dataset_stats: Dict[str, Any],
+    prefix: str = "prediction_error_future_proprio",
+) -> Dict[str, float]:
+    """Compare normalized future proprio prediction against actual normalized proprio."""
+    if predicted_normalized is None:
+        return {}
+    pred = _to_numpy_array(predicted_normalized).astype(np.float32)
+    pred = pred.reshape(-1, pred.shape[-1]).mean(axis=0)
+    actual = rescale_proprio(actual_raw, dataset_stats, non_negative_only=False, scale_multiplier=1.0).astype(
+        np.float32
+    )
+    diff = pred - actual
+    metrics = {
+        f"{prefix}_l2": float(np.linalg.norm(diff)),
+        f"{prefix}_mae": float(np.mean(np.abs(diff))),
+        f"{prefix}_max_abs": float(np.max(np.abs(diff))),
+    }
+    if len(diff) >= 5:
+        metrics[f"{prefix}_eef_pos_l2"] = float(np.linalg.norm(diff[2:5]))
+    if len(diff) >= 9:
+        metrics[f"{prefix}_eef_quat_l2"] = float(np.linalg.norm(diff[5:9]))
+    return metrics
+
+
+def object_state_delta_metrics(obs_before: Dict[str, Any], obs_after: Dict[str, Any]) -> Dict[str, float]:
+    """Track real object-state movement when LIBERO exposes object vectors."""
+    deltas = []
+    per_key = {}
+    skip_fragments = ("image", "robot0", "camera", "proprio")
+    for key, before in obs_before.items():
+        if key not in obs_after or any(fragment in key for fragment in skip_fragments):
+            continue
+        before_arr = np.asarray(before)
+        after_arr = np.asarray(obs_after[key])
+        if before_arr.shape != after_arr.shape or not np.issubdtype(before_arr.dtype, np.number):
+            continue
+        if before_arr.size == 0 or before_arr.size > 64:
+            continue
+        delta = float(np.linalg.norm(after_arr.astype(np.float64).ravel() - before_arr.astype(np.float64).ravel()))
+        deltas.append(delta)
+        per_key[f"actual_object_state_delta_l2__{key}"] = delta
+    if not deltas:
+        return {}
+    return {
+        "actual_object_state_delta_l2_mean": float(np.mean(deltas)),
+        "actual_object_state_delta_l2_max": float(np.max(deltas)),
+        "actual_object_state_num_keys": float(len(deltas)),
+        **per_key,
+    }
+
+
+def prediction_error_metrics_for_query(
+    sample: Dict[str, Any],
+    obs_before: Dict[str, Any],
+    obs_after: Dict[str, Any],
+    dataset_stats: Dict[str, Any],
+    flip_images: bool,
+    chunk_success: bool,
+) -> Dict[str, float]:
+    """Compare one query's future predictions against the observation after executing its chunk."""
+    future = sample.get("future_image_predictions", {})
+    metrics: Dict[str, float] = {}
+    metrics.update(
+        image_prediction_error_metrics(
+            future.get("future_image"),
+            get_libero_image(obs_after, flip_images=flip_images),
+            "prediction_error_future_image",
+        )
+    )
+    metrics.update(
+        image_prediction_error_metrics(
+            future.get("future_wrist_image"),
+            get_libero_wrist_image(obs_after, flip_images=flip_images),
+            "prediction_error_future_wrist",
+        )
+    )
+    metrics.update(
+        proprio_prediction_error_metrics(
+            extract_future_proprio_from_sample(sample),
+            proprio_from_libero_obs(obs_after),
+            dataset_stats,
+        )
+    )
+    if "value_prediction" in sample:
+        value = float(sample["value_prediction"])
+        metrics["prediction_error_value_abs_chunk_success"] = abs(value - float(chunk_success))
+        metrics["prediction_value_executed_sample"] = value
+    metrics.update(object_state_delta_metrics(obs_before, obs_after))
+    return metrics
+
+
+def _zscore_array(values: np.ndarray) -> np.ndarray:
+    values = np.asarray(values, dtype=np.float32)
+    mean = float(np.nanmean(values))
+    std = float(np.nanstd(values))
+    if not np.isfinite(std) or std < 1e-8:
+        std = 1.0
+    z = (values - mean) / std
+    z[~np.isfinite(z)] = 0.0
+    return z
+
+
+def _fill_nan_with_mean(values: np.ndarray) -> np.ndarray:
+    if np.isfinite(values).any():
+        fill = float(np.nanmean(values))
+    else:
+        fill = 0.0
+    return np.nan_to_num(values, nan=fill, posinf=fill, neginf=fill)
+
+
+def _candidate_action_consensus(samples: Sequence[Dict[str, Any]]) -> Tuple[np.ndarray, np.ndarray]:
+    """Return first-action and whole-chunk distance from the sampled consensus."""
+    actions = [np.asarray(sample["actions"], dtype=np.float32) for sample in samples]
+    if len(actions) == 1:
+        zeros = np.zeros(1, dtype=np.float32)
+        return zeros, zeros
+
+    first_actions = np.stack([action[0].reshape(-1) for action in actions])
+    chunk_actions = np.stack([action.reshape(-1) for action in actions])
+
+    def mean_pairwise_distance(values: np.ndarray) -> np.ndarray:
+        differences = values[:, None, :] - values[None, :, :]
+        distances = np.linalg.norm(differences, axis=-1)
+        return distances.sum(axis=1) / float(len(values) - 1)
+
+    return mean_pairwise_distance(first_actions), mean_pairwise_distance(chunk_actions)
+
+
+def _argmax_with_value_tiebreak(scores: np.ndarray, values: np.ndarray) -> int:
+    """Select the highest score and prefer value when scores are numerically tied."""
+    best_score = float(np.nanmax(scores))
+    tied = np.flatnonzero(np.isclose(scores, best_score, rtol=1e-6, atol=1e-7))
+    if len(tied) == 1:
+        return int(tied[0])
+    return int(tied[int(np.nanargmax(values[tied]))])
+
+
+def predict_future_proprio_error(
+    action_chunk_consistency_mean: float,
+    future_proprio_consistency_mean: float,
+    candidate_value_mean: float,
+    future_proprio_across_sample_std_mean: float,
+) -> float:
+    """Estimate next-chunk future-proprio L2 error from causal online signals."""
+    features = np.asarray(
+        [
+            action_chunk_consistency_mean,
+            future_proprio_consistency_mean,
+            candidate_value_mean,
+            future_proprio_across_sample_std_mean,
+        ],
+        dtype=np.float64,
+    )
+    logs = np.full_like(features, np.nan, dtype=np.float64)
+    valid = np.isfinite(features) & (features > 0.0)
+    logs[valid] = np.log(np.clip(features[valid], 1e-10, None))
+    logs[~np.isfinite(logs)] = PROPRIO_ERROR_SURROGATE_V1_LOG_MEDIANS[~np.isfinite(logs)]
+    normalized = (logs - PROPRIO_ERROR_SURROGATE_V1_LOG_MEANS) / PROPRIO_ERROR_SURROGATE_V1_LOG_STDS
+    predicted_log_error = float(
+        PROPRIO_ERROR_SURROGATE_V1_INTERCEPT + np.dot(PROPRIO_ERROR_SURROGATE_V1_COEFFICIENTS, normalized)
+    )
+    return float(np.exp(np.clip(predicted_log_error, -30.0, 30.0)))
+
+
+def select_planning_sample(
+    samples: Sequence[Dict[str, Any]],
+    strategy: str = "first",
+    risk_lambda: float = 1.0,
+    action_weight: float = 0.5,
+    *,
+    query_idx: int = 0,
+    episode_progress: float = 0.0,
+    episode_risk_enabled: Optional[bool] = None,
+    difficulty_threshold: float = 0.088588,
+    value_margin: float = 0.002,
+    uncertainty_margin: float = 0.0,
+    phase_fraction: float = 0.5,
+    open_loop_steps: int = 16,
+    short_open_loop_steps: int = 8,
+    surrogate_error_threshold: float = PROPRIO_ERROR_SURROGATE_V1_DEFAULT_THRESHOLD,
+) -> Tuple[int, Dict[str, Any]]:
+    """Select which sampled candidate chunk to execute.
+
+    `max_value` matches standard best-of-N planning.  Risk-aware strategies
+    normalize value and risk inside the current candidate set, which is the
+    planning use case we care about: choose the least risky candidate among
+    alternatives rather than apply a global fail threshold.
+    """
+    if len(samples) == 0:
+        raise ValueError("samples must be non-empty")
+    if not 0.0 <= action_weight <= 1.0:
+        raise ValueError("action_weight must be in [0, 1]")
+    if value_margin < 0.0:
+        raise ValueError("value_margin must be non-negative")
+    if uncertainty_margin < 0.0:
+        raise ValueError("uncertainty_margin must be non-negative")
+    if not 0.0 <= phase_fraction <= 1.0:
+        raise ValueError("phase_fraction must be in [0, 1]")
+    if not 1 <= short_open_loop_steps <= open_loop_steps:
+        raise ValueError("short_open_loop_steps must be in [1, open_loop_steps]")
+    if surrogate_error_threshold < 0.0:
+        raise ValueError("surrogate_error_threshold must be non-negative")
+
+    strategy = strategy.lower()
+    values = np.asarray([float(sample.get("value_prediction", np.nan)) for sample in samples], dtype=np.float32)
+    if not np.isfinite(values).any():
+        values = np.zeros(len(samples), dtype=np.float32)
+    values = _fill_nan_with_mean(values)
+    value_z = _zscore_array(values)
+
+    latent_metrics = [latent_internal_consistency(sample) for sample in samples]
+    action_first_consistency = np.asarray(
+        [
+            metrics.get("latent_action_first_step_copy_l2_std", metrics.get("latent_action_copy_std_mean", np.nan))
+            for metrics in latent_metrics
+        ],
+        dtype=np.float32,
+    )
+    action_chunk_consistency = np.asarray(
+        [metrics.get("latent_action_copy_std_mean", np.nan) for metrics in latent_metrics],
+        dtype=np.float32,
+    )
+    action_max_consistency = np.asarray(
+        [metrics.get("latent_action_copy_std_max", np.nan) for metrics in latent_metrics],
+        dtype=np.float32,
+    )
+    value_consistency = np.asarray(
+        [metrics.get("latent_value_element_std_mean", np.nan) for metrics in latent_metrics],
+        dtype=np.float32,
+    )
+    future_proprio_consistency = np.asarray(
+        [metrics.get("latent_future_proprio_copy_std_mean", np.nan) for metrics in latent_metrics],
+        dtype=np.float32,
+    )
+    action_first_consistency = _fill_nan_with_mean(action_first_consistency)
+    action_chunk_consistency = _fill_nan_with_mean(action_chunk_consistency)
+    action_max_consistency = _fill_nan_with_mean(action_max_consistency)
+    value_consistency = _fill_nan_with_mean(value_consistency)
+    future_proprio_consistency = _fill_nan_with_mean(future_proprio_consistency)
+
+    future_proprios = [
+        future_proprio
+        for future_proprio in (extract_future_proprio_from_sample(sample) for sample in samples)
+        if future_proprio is not None
+    ]
+    future_proprio_across_sample_std_mean = float("nan")
+    if len(future_proprios) >= 2:
+        future_proprio_across_sample_std_mean = float(np.stack(future_proprios).std(axis=0).mean())
+
+    predicted_proprio_error = predict_future_proprio_error(
+        float(np.nanmean(action_chunk_consistency)),
+        float(np.nanmean(future_proprio_consistency)),
+        float(np.nanmean(values)),
+        future_proprio_across_sample_std_mean,
+    )
+    surrogate_alarm = bool(predicted_proprio_error >= float(surrogate_error_threshold))
+
+    risk_action = -_zscore_array(action_first_consistency)
+    risk_value = -_zscore_array(value_consistency) - 0.5 * value_z
+    risk_combined = action_weight * risk_action + (1.0 - action_weight) * risk_value
+    uncertainty_action = _zscore_array(action_first_consistency)
+    uncertainty_action_chunk = _zscore_array(action_chunk_consistency)
+    uncertainty_action_max = _zscore_array(action_max_consistency)
+    uncertainty_value = _zscore_array(value_consistency)
+    uncertainty_combined = action_weight * uncertainty_action + (1.0 - action_weight) * uncertainty_value
+    consensus_first, consensus_chunk = _candidate_action_consensus(samples)
+    uncertainty_consensus = _zscore_array(consensus_first)
+
+    max_value_idx = int(np.nanargmax(values))
+    action_scores = value_z - float(risk_lambda) * uncertainty_action
+    action_idx = _argmax_with_value_tiebreak(action_scores, values)
+    query_risk_enabled = False
+    requery_triggered = False
+    selected_open_loop_steps = int(open_loop_steps)
+    effective_strategy = strategy
+
+    if strategy == "first":
+        scores = values.copy()
+        selected = 0
+        risk = np.zeros(len(samples), dtype=np.float32)
+    elif strategy in {"max_value", "max_value_replay"}:
+        scores = values.copy()
+        selected = int(np.nanargmax(scores))
+        risk = np.zeros(len(samples), dtype=np.float32)
+    elif strategy in {"risk_aware_action", "risk_action"}:
+        risk = risk_action
+        scores = value_z - float(risk_lambda) * risk
+        selected = _argmax_with_value_tiebreak(scores, values)
+    elif strategy in {"risk_aware_value", "risk_value"}:
+        risk = risk_value
+        scores = value_z - float(risk_lambda) * risk
+        selected = _argmax_with_value_tiebreak(scores, values)
+    elif strategy in {"risk_aware_combined", "risk_combined"}:
+        risk = risk_combined
+        scores = value_z - float(risk_lambda) * risk
+        selected = _argmax_with_value_tiebreak(scores, values)
+    elif strategy in {
+        "uncertainty_penalty_action",
+        "uncertainty_penalty_action_replay",
+        "uncertainty_action",
+    }:
+        risk = uncertainty_action
+        scores = value_z - float(risk_lambda) * risk
+        selected = _argmax_with_value_tiebreak(scores, values)
+    elif strategy in {"uncertainty_penalty_action_chunk", "uncertainty_action_chunk"}:
+        risk = uncertainty_action_chunk
+        scores = value_z - float(risk_lambda) * risk
+        selected = _argmax_with_value_tiebreak(scores, values)
+    elif strategy in {"uncertainty_penalty_action_max", "uncertainty_action_max"}:
+        risk = uncertainty_action_max
+        scores = value_z - float(risk_lambda) * risk
+        selected = _argmax_with_value_tiebreak(scores, values)
+    elif strategy in {"uncertainty_penalty_value", "uncertainty_value"}:
+        risk = uncertainty_value
+        scores = value_z - float(risk_lambda) * risk
+        selected = _argmax_with_value_tiebreak(scores, values)
+    elif strategy in {"uncertainty_penalty_combined", "uncertainty_combined"}:
+        risk = uncertainty_combined
+        scores = value_z - float(risk_lambda) * risk
+        selected = _argmax_with_value_tiebreak(scores, values)
+    elif strategy in {"difficulty_gated_action", "episode_value_gated_action"}:
+        if episode_risk_enabled is None:
+            episode_risk_enabled = bool(float(np.mean(values)) >= float(difficulty_threshold))
+        query_risk_enabled = bool(episode_risk_enabled)
+        risk = uncertainty_action
+        scores = action_scores if query_risk_enabled else values.copy()
+        selected = action_idx if query_risk_enabled else max_value_idx
+        effective_strategy = "uncertainty_penalty_action" if query_risk_enabled else "max_value"
+    elif strategy in {"margin_gated_action", "conservative_action_gate"}:
+        risk = uncertainty_action
+        risk_value_gap = float(values[max_value_idx] - values[action_idx])
+        risk_uncertainty_gain = float(uncertainty_action[max_value_idx] - uncertainty_action[action_idx])
+        query_risk_enabled = bool(
+            action_idx != max_value_idx
+            and risk_value_gap <= float(value_margin)
+            and risk_uncertainty_gain >= float(uncertainty_margin)
+        )
+        scores = action_scores if query_risk_enabled else values.copy()
+        selected = action_idx if query_risk_enabled else max_value_idx
+        effective_strategy = "uncertainty_penalty_action" if query_risk_enabled else "max_value"
+    elif strategy in {"consensus_action", "uncertainty_penalty_consensus"}:
+        risk = uncertainty_consensus
+        scores = value_z - float(risk_lambda) * risk
+        selected = _argmax_with_value_tiebreak(scores, values)
+    elif strategy in {"phase_gated_action", "early_phase_action"}:
+        query_risk_enabled = bool(float(episode_progress) <= float(phase_fraction))
+        risk = uncertainty_action
+        scores = action_scores if query_risk_enabled else values.copy()
+        selected = action_idx if query_risk_enabled else max_value_idx
+        effective_strategy = "uncertainty_penalty_action" if query_risk_enabled else "max_value"
+    elif strategy in {"phase_requery_action", "phase_disagreement_requery_action"}:
+        query_risk_enabled = bool(float(episode_progress) <= float(phase_fraction))
+        risk = uncertainty_action
+        scores = action_scores if query_risk_enabled else values.copy()
+        selected = action_idx if query_risk_enabled else max_value_idx
+        effective_strategy = "uncertainty_penalty_action" if query_risk_enabled else "max_value"
+        requery_triggered = bool(query_risk_enabled and action_idx != max_value_idx)
+        if requery_triggered:
+            selected_open_loop_steps = int(short_open_loop_steps)
+    elif strategy in {"max_value_disagreement_requery", "horizon_only_max_value"}:
+        # Preserve the baseline candidate and use risk disagreement only to
+        # decide when the environment should be observed again.
+        risk = uncertainty_action
+        scores = values.copy()
+        selected = max_value_idx
+        effective_strategy = "max_value"
+        requery_triggered = bool(action_idx != max_value_idx)
+        if requery_triggered:
+            selected_open_loop_steps = int(short_open_loop_steps)
+    elif strategy in {"disagreement_requery_action", "adaptive_horizon_action"}:
+        risk = uncertainty_action
+        scores = action_scores
+        selected = action_idx
+        requery_triggered = bool(action_idx != max_value_idx)
+        if requery_triggered:
+            selected_open_loop_steps = int(short_open_loop_steps)
+    elif strategy == "surrogate_gated_requery_action":
+        query_risk_enabled = surrogate_alarm
+        risk = uncertainty_action
+        scores = action_scores if query_risk_enabled else values.copy()
+        selected = action_idx if query_risk_enabled else max_value_idx
+        effective_strategy = "uncertainty_penalty_action" if query_risk_enabled else "max_value"
+        requery_triggered = surrogate_alarm
+        if requery_triggered:
+            selected_open_loop_steps = int(short_open_loop_steps)
+    elif strategy == "surrogate_horizon_action":
+        query_risk_enabled = True
+        risk = uncertainty_action
+        scores = action_scores
+        selected = action_idx
+        requery_triggered = surrogate_alarm
+        if requery_triggered:
+            selected_open_loop_steps = int(short_open_loop_steps)
+    elif strategy == "surrogate_disagreement_requery_action":
+        query_risk_enabled = True
+        risk = uncertainty_action
+        scores = action_scores
+        selected = action_idx
+        requery_triggered = bool(surrogate_alarm and action_idx != max_value_idx)
+        if requery_triggered:
+            selected_open_loop_steps = int(short_open_loop_steps)
+    elif strategy == "phase_surrogate_requery_action":
+        phase_enabled = bool(float(episode_progress) <= float(phase_fraction))
+        query_risk_enabled = bool(phase_enabled or surrogate_alarm)
+        risk = uncertainty_action
+        scores = action_scores if query_risk_enabled else values.copy()
+        selected = action_idx if query_risk_enabled else max_value_idx
+        effective_strategy = "uncertainty_penalty_action" if query_risk_enabled else "max_value"
+        requery_triggered = surrogate_alarm
+        if requery_triggered:
+            selected_open_loop_steps = int(short_open_loop_steps)
+    elif strategy in {"difficulty_gated_requery_action", "adaptive_difficulty_action"}:
+        if episode_risk_enabled is None:
+            episode_risk_enabled = bool(float(np.mean(values)) >= float(difficulty_threshold))
+        query_risk_enabled = bool(episode_risk_enabled)
+        risk = uncertainty_action
+        scores = action_scores if query_risk_enabled else values.copy()
+        selected = action_idx if query_risk_enabled else max_value_idx
+        effective_strategy = "uncertainty_penalty_action" if query_risk_enabled else "max_value"
+        requery_triggered = bool(query_risk_enabled and action_idx != max_value_idx)
+        if requery_triggered:
+            selected_open_loop_steps = int(short_open_loop_steps)
+    else:
+        raise ValueError(
+            f"Unknown planning selection strategy: {strategy}. "
+            "Use first, max_value, risk_aware_*, uncertainty_penalty_*, or an adaptive strategy."
+        )
+
+    risk_value_gap = float(values[max_value_idx] - values[action_idx])
+    risk_uncertainty_gain = float(uncertainty_action[max_value_idx] - uncertainty_action[action_idx])
+
+    diagnostics = {
+        "planning_strategy": strategy,
+        "planning_effective_strategy": effective_strategy,
+        "planning_risk_lambda": float(risk_lambda),
+        "planning_action_weight": float(action_weight),
+        "planning_difficulty_threshold": float(difficulty_threshold),
+        "planning_value_margin": float(value_margin),
+        "planning_uncertainty_margin": float(uncertainty_margin),
+        "planning_phase_fraction": float(phase_fraction),
+        "planning_short_open_loop_steps": float(short_open_loop_steps),
+        "planning_surrogate_error_threshold": float(surrogate_error_threshold),
+        "planning_predicted_proprio_error": float(predicted_proprio_error),
+        "planning_surrogate_alarm": bool(surrogate_alarm),
+        "planning_episode_risk_enabled": bool(episode_risk_enabled) if episode_risk_enabled is not None else False,
+        "planning_query_risk_enabled": bool(query_risk_enabled),
+        "planning_requery_triggered": bool(requery_triggered),
+        "planning_selected_open_loop_steps": float(selected_open_loop_steps),
