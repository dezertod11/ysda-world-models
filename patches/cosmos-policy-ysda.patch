+    """Collect traces for multiple suites/tasks/episodes."""
+    output_dir.mkdir(parents=True, exist_ok=True)
+    resolved_temporal_overlap_dir = temporal_overlap_dir or (output_dir / f"{run_name}__temporal_overlap")
+    if record_temporal_overlap:
+        resolved_temporal_overlap_dir.mkdir(parents=True, exist_ok=True)
+    all_traces: List[pd.DataFrame] = []
+
+    # Load once.  We validate/prewarm using the first suite, then reuse the model for the rest.
+    cfg = default_policy_config(
