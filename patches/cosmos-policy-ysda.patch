+def rollout_uses_intervention(spec: str, rollout_id: int) -> bool:
+    spec = (spec or "").strip().lower()
+    if spec in {"", "none"}:
+        return False
+    if spec == "all":
+        return True
+    if spec == "odd":
+        return rollout_id % 2 == 1
+    if spec == "even":
+        return rollout_id % 2 == 0
+    return rollout_id in set(parse_int_list(spec))
